<Window x:Class="ResourceCalculator.Views.UpdateProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оновлення" Height="Auto" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="../Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="18" Padding="4">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource IconBadge}" Background="{DynamicResource AccentSoftBg}" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE74A;" Foreground="{DynamicResource AccentBg}"/>
                </Border>
                <TextBlock Text="Оновлення" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <TextBlock x:Name="TxtVersion" FontSize="13" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,8"/>

            <ProgressBar x:Name="ProgressBar" Height="6" Margin="0,0,0,8"
                         Background="{DynamicResource InputBg}" Foreground="{DynamicResource AccentBg}"/>

            <TextBlock x:Name="TxtStatus" FontSize="12" Foreground="{DynamicResource TextMuted}"
                       TextWrapping="Wrap" Margin="0,0,0,16"/>

            <Button x:Name="BtnCancel" Content="Скасувати" Padding="16,7" HorizontalAlignment="Right"
                    Click="BtnCancel_Click"/>
        </StackPanel>
    </Border>
</Window>
