<Window x:Class="ResourceCalculator.Views.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ResourceCalculator.Localization"
        Title="{loc:Loc access.changeTitle}" Height="Auto" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="18" Padding="4">
        <StackPanel>
            <TextBlock Text="{loc:Loc access.changeTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,12"/>

            <TextBlock Text="{loc:Loc access.current}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtCurrent" Margin="0,0,0,8" Padding="6,5" FontSize="13" KeyDown="Txt_KeyDown"/>

            <TextBlock Text="{loc:Loc access.newPassword}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtNew" Margin="0,0,0,8" Padding="6,5" FontSize="13" KeyDown="Txt_KeyDown"/>

            <TextBlock Text="{loc:Loc access.confirm}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtConfirm" Margin="0,0,0,6" Padding="6,5" FontSize="13" KeyDown="Txt_KeyDown"/>

            <TextBlock x:Name="TxtError" Text="{loc:Loc access.changeError}" FontSize="11" Foreground="{DynamicResource DangerBg}"
                       TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

            <TextBlock Text="{loc:Loc access.changeRules}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,4,0,10"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True" Content="{loc:Loc access.cancel}" Padding="16,7" Margin="0,0,6,0"/>
                <Button Content="{loc:Loc access.save}" Padding="20,7" Click="BtnSave_Click"
                        Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
