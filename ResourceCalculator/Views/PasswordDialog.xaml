<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ResourceCalculator.Localization"
        x:Class="ResourceCalculator.Views.PasswordDialog"
        x:CompileBindings="False"
        Title="{loc:Loc access.title}" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" CanResize="False" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <Border Classes="card" Margin="18" Padding="4">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Classes="iconbadge" Background="{DynamicResource PurpleSoftBg}" Margin="0,0,10,0">
                    <TextBlock Classes="iconglyph" Text="&#xE72E;" Foreground="{DynamicResource PurpleBg}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="{loc:Loc access.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock x:Name="TxtSubtitle" Text="{loc:Loc access.subtitle}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <!-- Режим розблокування -->
            <StackPanel x:Name="UnlockPanel">
                <TextBlock Text="{loc:Loc access.enterPassword}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                <TextBox PasswordChar="*" x:Name="TxtPassword" Margin="0,0,0,6" Padding="6,5" FontSize="13"
                             KeyDown="TxtPassword_KeyDown"/>
            </StackPanel>

            <!-- Режим першого запуску: пароль ще не встановлено -->
            <StackPanel x:Name="SetupPanel" IsVisible="False">
                <TextBlock Text="{loc:Loc access.setupHint}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                <TextBlock Text="{loc:Loc access.newPassword}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                <TextBox PasswordChar="*" x:Name="TxtNewPassword" Margin="0,0,0,6" Padding="6,5" FontSize="13"/>
                <TextBlock Text="{loc:Loc access.confirm}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                <TextBox PasswordChar="*" x:Name="TxtConfirmPassword" Margin="0,0,0,6" Padding="6,5" FontSize="13"
                             KeyDown="TxtPassword_KeyDown"/>
            </StackPanel>

            <TextBlock x:Name="TxtError" FontSize="11" Foreground="{DynamicResource DangerBg}"
                       TextWrapping="Wrap" Margin="0,0,0,4" IsVisible="False"/>

            <Border x:Name="ForgotPanel" Classes="card" Background="{DynamicResource HighlightBg}" CornerRadius="8" Padding="12" Margin="0,4,0,10"
                    BorderBrush="{DynamicResource AccentBg}" BorderThickness="1.5">
                <StackPanel>
                    <TextBlock Text="{loc:Loc access.forgotHint}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,6">
                        <SelectableTextBlock x:Name="Email1Text" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBg}"
                                   VerticalAlignment="Center" Cursor="Hand"
                                   PointerPressed="Email_PointerPressed"
                                   ToolTip.Tip="Натисніть, щоб написати листа. Текст можна виділити і скопіювати."/>
                        <Button Grid.Column="1" x:Name="Email1WriteBtn" Content="✉" Padding="10,4" Margin="8,0,0,0" Click="EmailWrite_Click"
                                ToolTip.Tip="Написати листа"/>
                        <Button Grid.Column="2" x:Name="Email1CopyBtn" Content="{loc:Loc access.copy}" Padding="12,4" Margin="6,0,0,0" Click="EmailCopy_Click"
                                ToolTip.Tip="Скопіювати адресу"/>
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,2">
                        <SelectableTextBlock x:Name="Email2Text" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource AccentBg}"
                                   VerticalAlignment="Center" Cursor="Hand"
                                   PointerPressed="Email_PointerPressed"
                                   ToolTip.Tip="Натисніть, щоб написати листа. Текст можна виділити і скопіювати."/>
                        <Button Grid.Column="1" x:Name="Email2WriteBtn" Content="✉" Padding="10,4" Margin="8,0,0,0" Click="EmailWrite_Click"
                                ToolTip.Tip="Написати листа"/>
                        <Button Grid.Column="2" x:Name="Email2CopyBtn" Content="{loc:Loc access.copy}" Padding="12,4" Margin="6,0,0,0" Click="EmailCopy_Click"
                                ToolTip.Tip="Скопіювати адресу"/>
                    </Grid>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True" Content="{loc:Loc access.cancel}" Padding="16,7" Margin="0,0,6,0"/>
                <Button x:Name="BtnOk" Content="{loc:Loc access.unlock}" Padding="20,7" Click="BtnOk_Click"
                        Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
