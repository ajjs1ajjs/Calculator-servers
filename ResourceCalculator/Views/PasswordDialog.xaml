<Window x:Class="ResourceCalculator.Views.PasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:ResourceCalculator.Localization"
        Title="{loc:Loc access.title}" Height="Auto" Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>
    <Border Margin="18" Padding="4">
        <StackPanel>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Border Style="{StaticResource IconBadge}" Background="{DynamicResource PurpleSoftBg}" Margin="0,0,10,0">
                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE72E;" Foreground="{DynamicResource PurpleBg}"/>
                </Border>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc access.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                    <TextBlock Text="{loc:Loc access.subtitle}" FontSize="11" Foreground="{DynamicResource TextMuted}"/>
                </StackPanel>
            </StackPanel>

            <TextBlock Text="{loc:Loc access.enterPassword}" FontSize="12" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
            <PasswordBox x:Name="TxtPassword" Margin="0,0,0,6" Padding="6,5" FontSize="13"
                         KeyDown="TxtPassword_KeyDown"/>
            <TextBlock x:Name="TxtError" Text="{loc:Loc access.error}" FontSize="11" Foreground="{DynamicResource DangerBg}"
                       TextWrapping="Wrap" Margin="0,0,0,4" Visibility="Collapsed"/>

            <Border Background="{DynamicResource HighlightBg}" CornerRadius="8" Padding="10" Margin="0,4,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc access.forgotHint}" FontSize="11" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                    <TextBlock Text="{Binding DevContacts}" FontSize="11" Foreground="{DynamicResource AccentBg}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <Button Content="{loc:Loc access.regenerate}" Padding="12,6" Click="BtnRegenerate_Click" HorizontalAlignment="Left"
                            Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"/>
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button IsCancel="True" Content="{loc:Loc access.cancel}" Padding="16,7" Margin="0,0,6,0"/>
                <Button x:Name="BtnOk" Content="{loc:Loc access.unlock}" Padding="20,7" Click="BtnOk_Click"
                        Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
