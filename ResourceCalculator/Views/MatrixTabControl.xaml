<UserControl x:Class="ResourceCalculator.Views.MatrixTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:ResourceCalculator.Localization">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{loc:Loc matrix.info}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                    <TextBlock Text="{loc:Loc access.lockedHint}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="16,8"
                        Command="{Binding MatrixVM.SaveMatrixCommand}">
                    <TextBlock Text="{loc:Loc matrix.save}"/>
                </Button>
                <Button Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="16,8"
                        Command="{Binding MatrixVM.RecalculateMatrixCommand}" ToolTip="{loc:Loc matrix.recalcHint}">
                    <TextBlock Text="{loc:Loc matrix.recalc}"/>
                </Button>
                <Button Command="{Binding MatrixVM.ResetMatrixCommand}" Padding="12,8">
                    <TextBlock Text="{loc:Loc matrix.reset}"/>
                </Button>
                <Button Command="{Binding MatrixVM.ChangePasswordCommand}" Padding="12,8" Margin="0,0,0,0">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{loc:Loc access.changePassword}" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <Expander Header="{loc:Loc matrix.msSql}" IsExpanded="True">
                <DataGrid x:Name="GridMatrixMsSql" Height="160" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.MsSqlRanges}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.throughput}" Binding="{Binding ThroughputMiBs, Mode=TwoWay}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.appServer}">
                <DataGrid Height="130" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.AppServerRanges}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding InstanceCount, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ghz}" Binding="{Binding Ghz, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.webServer}">
                <DataGrid Height="130" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.WebServerRanges}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding InstanceCount, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ghz}" Binding="{Binding Ghz, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.postgres}">
                <DataGrid Height="130" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.PostgresRanges}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency, Mode=TwoWay}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.oracle}">
                <DataGrid Height="130" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.OracleRanges}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="65"/>
                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency, Mode=TwoWay}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.k8sDocumentFlow}" IsExpanded="True">
                <DataGrid Height="160" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.K8sDocumentFlowComponents}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.category}" Binding="{Binding Category, Mode=TwoWay}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="160"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.perfCpu}" Binding="{Binding PerfCpu, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.perfRam}" Binding="{Binding PerfRamGb, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.fixedReplicas}" Binding="{Binding FixedReplicas, Mode=TwoWay}" Width="70"/>
                        <DataGridComboBoxColumn Header="{loc:Loc col.formula}" SelectedItemBinding="{Binding Formula, Mode=TwoWay}" Width="130"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.infra}" IsExpanded="True">
                <DataGrid x:Name="GridMatrixInfra" Height="150" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.InfraNodes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="120"/>
                        <DataGridTextColumn Header="{loc:Loc col.os}" Binding="{Binding Os, Mode=TwoWay}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding StorageGb, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.infraWindows}">
                <DataGrid Height="130" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.WindowsInfraNodes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc col.os}" Binding="{Binding Os, Mode=TwoWay}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding StorageGb, Mode=TwoWay}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.infraOptional}">
                <DataGrid Height="130" IsReadOnly="False" CanUserAddRows="True" BeginningEdit="Grid_BeginningEdit"
                          ItemsSource="{Binding MatrixVM.OptionalInfraNodes}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc col.os}" Binding="{Binding Os, Mode=TwoWay}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="60"/>
                        <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount, Mode=TwoWay}" Width="55"/>
                        <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding StorageGb, Mode=TwoWay}" Width="60"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Expander>

            <Expander Header="{loc:Loc matrix.engineSettings}" IsExpanded="False">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Margin="0,4,16,4">
                        <TextBlock Text="{loc:Loc engine.smartId}" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc engine.smartIdCpu}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.SmartIdCpuPerReplica, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.smartIdRam}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.SmartIdRamPerReplicaGb, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Loc engine.iopsProfiles}" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc engine.dbIops}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.DbIopsProfile, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.appIops}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.AppServerIopsProfile, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.webIops}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.WebServerIopsProfile, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.k8sIops}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.K8sIopsProfile, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,8"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="16,4,0,4">
                        <TextBlock Text="{loc:Loc engine.workerNode}" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc engine.workerCpu}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.DefaultWorkerCpu, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.workerRam}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.DefaultWorkerRamGb, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.workerIops}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.DefaultWorkerIops, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Loc engine.sqlLimits}" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc engine.sqlMaxRam}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.MsSqlStandardMaxRamGb, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.sqlMaxCores}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.MsSqlStandardMaxCores, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,8"/>

                        <TextBlock Text="{loc:Loc engine.pagefile}" FontWeight="Bold" Margin="0,0,0,4"/>
                        <TextBlock Text="{loc:Loc engine.pagefileMult}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.PageFileMultiplier, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                        <TextBlock Text="{loc:Loc engine.pagefileRound}" FontSize="12" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding MatrixVM.Engine.PageFileRounding, Mode=TwoWay}" Padding="4,2" Margin="0,0,0,6"/>
                    </StackPanel>
                </Grid>
            </Expander>
        </StackPanel>
    </ScrollViewer>
</UserControl>
