<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:ResourceCalculator.Converters"
             xmlns:loc="clr-namespace:ResourceCalculator.Localization"
             x:Class="ResourceCalculator.Views.CalculatorTabControl"
              x:CompileBindings="False">
    <UserControl.Resources>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="{loc:Loc setup.title}" FontSize="18" FontWeight="Bold" Margin="0,0,0,10" Foreground="{DynamicResource TextPrimary}"/>
            <Grid ColumnDefinitions="*,16,*">
                <StackPanel Grid.Column="0">
                    <Border Classes="card" >
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Classes="iconbadge" Background="{DynamicResource AccentSoftBg}" Margin="0,0,10,0">
                                    <TextBlock Classes="iconglyph" Text="&#xE713;" Foreground="{DynamicResource AccentBg}"/>
                                </Border>
                                <TextBlock Classes="cardheader" Text="ОСНОВНІ НАЛАШТУВАННЯ" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8" RowDefinitions="Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="180,*">
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc setup.users}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserCount" Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc setup.deployment}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding DeploymentIndex, Mode=TwoWay}" Margin="3" Padding="4">
                                    <ComboBoxItem Content="{loc:Loc deploy.k8s}"/><ComboBoxItem Content="{loc:Loc deploy.windows}"/><ComboBoxItem Content="{loc:Loc deploy.hybrid}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding DatabaseIndex, Mode=TwoWay}" Margin="3" Padding="4">
                                    <ComboBoxItem Content="SQL Server"/><ComboBoxItem Content="PostgreSQL"/><ComboBoxItem Content="Oracle 19c"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc env.dbData}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProdDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc env.contentData}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ProdContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Classes="card" >
                        <StackPanel>
                            <Grid Margin="0,0,0,14" ColumnDefinitions="Auto,*,Auto">
                                <Border Classes="iconbadge" Grid.Column="0" Background="{DynamicResource PurpleSoftBg}" Margin="0,0,10,0">
                                    <TextBlock Classes="iconglyph" Text="&#xEA86;" Foreground="{DynamicResource PurpleBg}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{loc:Loc modules.title}" Margin="0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Порожньо = усі користувачі" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl x:Name="ModulesPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="chip" Margin="0,0,0,8">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                          VerticalAlignment="Center"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                            IsVisible="{Binding HasOwnUserCount}">
                                                    <TextBlock Text="Користувачів:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox Width="60" Padding="3,1" FontSize="12" VerticalAlignment="Center"
                                                              Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                             IsEnabled="{Binding IsEnabled}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Classes="card"  Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Classes="iconbadge" Background="{DynamicResource SurfaceBg}" Margin="0,0,10,0">
                                    <TextBlock Classes="iconglyph" Text="&#xE977;" Foreground="{DynamicResource TextMuted}"/>
                                </Border>
                                <TextBlock Classes="cardheader" Text="ДОДАТКОВІ ВУЗЛИ СИСТЕМИ" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <UniformGrid Columns="3">
                                <Border Classes="chip" Margin="0,0,8,0">
                                    <CheckBox Content="Сервер звітів" IsChecked="{Binding IncludeReportingServer, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Classes="chip" Margin="0,0,8,0">
                                    <CheckBox Content="SQL Secondary (Failover)" IsChecked="{Binding IncludeSqlFailover, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                                <Border Classes="chip">
                                    <CheckBox Content="HAProxy" IsChecked="{Binding IncludeHaProxy, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12"/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid>
                <StackPanel>
                    <Border Classes="card"  Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10" ColumnDefinitions="*,Auto">
                                <TextBlock Grid.Column="0" Text="{loc:Loc env.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                <Border Classes="pillgroup" Grid.Column="1" ToolTip.Tip="{loc:Loc tooltip.env}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="{loc:Loc env.dev}" IsChecked="{Binding IncludeDev, Mode=TwoWay}" Classes="envtoggle"/>
                                        <CheckBox Content="{loc:Loc env.test}" IsChecked="{Binding IncludeTest, Mode=TwoWay}" Classes="envtoggle"/>
                                        <CheckBox Content="{loc:Loc env.predprod}" IsChecked="{Binding IncludePredProd, Mode=TwoWay}" Classes="envtoggle"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <TextBlock Text="Налаштування ввімкнених середовищ" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,2,0,4"
                                       IsVisible="{Binding HasEnvironmentsSelected}"/>
                            <Grid ColumnDefinitions="*,*,*">
                                <Border Classes="card" Grid.Column="0" IsVisible="{Binding IncludeDev}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10"
                                        Padding="16" Margin="0,0,10,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <Ellipse Fill="{DynamicResource AccentBg}"/>
                                                <TextBlock Text="{loc:Loc env.dev}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <Border Classes="card" Grid.Column="1">
                                                <TextBlock Text="АКТИВНЕ"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6" ColumnDefinitions="*,90" RowDefinitions="Auto,Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding DevUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc env.dbData}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding DevDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc env.contentData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DevContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        </Grid>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   IsVisible="{Binding HasEnvModuleCounts}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      IsVisible="{Binding HasEnvModuleCounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1" ColumnDefinitions="22,*,58">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="2" Text="{Binding DevUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding DevEnabled}"
                                                                 IsVisible="{Binding HasOwnUserCount}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="вњ“" Binding="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Grid.Column="1" IsVisible="{Binding IncludeTest}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10"
                                        Padding="16" Margin="0,0,10,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <Ellipse Fill="{DynamicResource SuccessBg}"/>
                                                <TextBlock Text="{loc:Loc env.test}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <Border Classes="card" Grid.Column="1">
                                                <TextBlock Text="АКТИВНЕ"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,2" ColumnDefinitions="*,90" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding TestUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc env.dbData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TestDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        </Grid>
                                        <TextBlock Text="{Binding TestDbSizeWarning}" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource DangerBg}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                                   IsVisible="{Binding HasTestDbSizeWarning}"/>
                                        <Grid Margin="0,0,0,6" ColumnDefinitions="*,90">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc env.contentData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding TestContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        </Grid>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   IsVisible="{Binding HasEnvModuleCounts}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      IsVisible="{Binding HasEnvModuleCounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1" ColumnDefinitions="22,*,58">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="2" Text="{Binding TestUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding TestEnabled}"
                                                                 IsVisible="{Binding HasOwnUserCount}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="вњ“" Binding="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <Border Classes="card" Grid.Column="2" IsVisible="{Binding IncludePredProd}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10"
                                        Padding="16" Margin="0,0,0,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4" ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <Ellipse Fill="{DynamicResource PurpleBg}"/>
                                                <TextBlock Text="{loc:Loc env.predprod}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <Border Classes="card" Grid.Column="1">
                                                <TextBlock Text="АКТИВНЕ"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,2" ColumnDefinitions="*,90" RowDefinitions="Auto,Auto">
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding PredProdUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc env.dbData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PredProdDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        </Grid>
                                        <TextBlock Text="{Binding PredProdDbSizeWarning}" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource DangerBg}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                                   IsVisible="{Binding HasPredProdDbSizeWarning}"/>
                                        <Grid Margin="0,0,0,6" ColumnDefinitions="*,90">
                                            <TextBlock Grid.Column="0" Text="{loc:Loc env.contentData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding PredProdContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4"/>
                                        </Grid>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   IsVisible="{Binding HasEnvModuleCounts}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      IsVisible="{Binding HasEnvModuleCounts}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1" ColumnDefinitions="22,*,58">
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <TextBox Grid.Column="2" Text="{Binding PredProdUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding PredProdEnabled}"
                                                                 IsVisible="{Binding HasOwnUserCount}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  >
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="вњ“" Binding="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="24,14"
                            Command="{Binding CalculateCommand}" FontSize="15" Margin="0,15,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="{loc:Loc setup.calculate}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <Border Classes="card"  Margin="0,16,0,0"
                            IsVisible="{Binding HasResultSummary}">
                        <StackPanel>
                            <TextBlock Classes="cardheader" Text="ОСТАННІЙ РОЗРАХУНОК"/>
                            <UniformGrid Columns="5">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalCpu}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBg}"/>
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalRam}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBg}"/>
                                    <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalStorage}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBg}"/>
                                    <TextBlock Text="ДИСКИ" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalIops}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PurpleBg}"/>
                                    <TextBlock Text="IOPS" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalNodes}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerBg}"/>
                                    <TextBlock Text="ВМ" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <Button Background="Transparent" Foreground="{DynamicResource AccentBg}" FontWeight="Bold" Padding="0" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" BorderThickness="0"
                                    Click="OpenResultsTab_Click">
                                <TextBlock Text="Детальніше у вкладці «Результати» &#x2192;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

