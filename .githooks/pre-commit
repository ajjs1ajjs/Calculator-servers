#!/bin/sh
# Docs-sync pre-commit: дооновлює AUTO-маркери в MD-доках і додає їх у той самий коміт.
# Не блокує коміт ніколи (exit 0): змістовні правки доків — відповідальність автора,
# скрипт лише підкаже про розсинхрон. Установка: git config core.hooksPath .githooks
if command -v pwsh >/dev/null 2>&1; then
  PS=pwsh
elif command -v powershell >/dev/null 2>&1; then
  PS=powershell
else
  echo "[docs-sync] powershell не знайдено — пропускаю оновлення маркерів"
  exit 0
fi
$PS -NoProfile -NonInteractive -File scripts/Update-Docs.ps1
git add ARCHITECTURE.md DATA-MODELS.md IMPLEMENTATION.md FUNCTIONS.md TESTS.md AGENTS.md
exit 0
