<UserControl x:Class="AIResourceCalculator.Views.CalculatorTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
             xmlns:loc="clr-namespace:AIResourceCalculator.Localization">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:ZeroEmptyConverter x:Key="ZeroEmptyConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc setup.title}" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{DynamicResource CardBg}" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc setup.users}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.users}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserCount" Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14" ToolTip="{loc:Loc tooltip.users}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc setup.product}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.product}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding ProductIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.product}">
                                    <ComboBoxItem Content="{loc:Loc product.standard}"/><ComboBoxItem Content="{loc:Loc product.documentflow}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc setup.deployment}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.deployment}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding DeploymentIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.deployment}">
                                    <ComboBoxItem Content="{loc:Loc deploy.k8s}"/><ComboBoxItem Content="{loc:Loc deploy.windows}"/><ComboBoxItem Content="{loc:Loc deploy.hybrid}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Database" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.database}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding DatabaseIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.database}">
                                    <ComboBoxItem Content="SQL Server"/><ComboBoxItem Content="PostgreSQL"/><ComboBoxItem Content="Oracle 19c"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc modules.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ModulesPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2,14,2">
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                      VerticalAlignment="Center" ToolTip="{Binding Description}"/>
                                            <TextBox Width="50" Margin="6,0,0,0" Padding="3,1" FontSize="12" VerticalAlignment="Center"
                                                     Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ZeroEmptyConverter}}"
                                                     ToolTip="{loc:Loc modules.usersTooltip}"
                                                     IsEnabled="{Binding IsEnabled}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Додаткові вузли" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"
                                       ToolTip="Опціональні вузли — додаються до розрахунку лише коли увімкнені (типово вимкнені)"/>
                            <WrapPanel>
                                <CheckBox Content="Сервер звітів" IsChecked="{Binding IncludeReportingServer, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"
                                          ToolTip="Reporting Services, окремий вузол 2 ядра / 4 ГБ (Windows)"/>
                                <CheckBox Content="SQL Secondary (Failover)" IsChecked="{Binding IncludeSqlFailover, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"
                                          ToolTip="Другий вузол БД для failover-кластера (копія первинного вузла БД)"/>
                                <CheckBox Content="HAProxy" IsChecked="{Binding IncludeHaProxy, Mode=TwoWay}" FontWeight="SemiBold"
                                          ToolTip="Балансувальник навантаження 2 ядра / 4 ГБ (Linux)"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc env.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" ToolTip="{loc:Loc tooltip.env}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip="{loc:Loc tooltip.env}">
                                <CheckBox Content="{loc:Loc env.dev}" IsChecked="{Binding IncludeDev, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <CheckBox Content="{loc:Loc env.test}" IsChecked="{Binding IncludeTest, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <CheckBox Content="{loc:Loc env.predprod}" IsChecked="{Binding IncludePredProd, Mode=TwoWay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <WrapPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                    <TextBlock Text="{loc:Loc env.devUsers}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{loc:Loc tooltip.devUsers}"/>
                                    <TextBox Width="55" Text="{Binding DevUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4" ToolTip="{loc:Loc tooltip.devUsers}" IsEnabled="{Binding IncludeDev}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                    <TextBlock Text="{loc:Loc env.testUsers}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{loc:Loc tooltip.testUsers}"/>
                                    <TextBox Width="55" Text="{Binding TestUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4" ToolTip="{loc:Loc tooltip.testUsers}" IsEnabled="{Binding IncludeTest}"/>
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,16,4">
                                    <TextBlock Text="{loc:Loc env.predprodUsers}" VerticalAlignment="Center" Margin="0,0,4,0" ToolTip="{loc:Loc tooltip.predprodUsers}"/>
                                    <TextBox Width="55" Text="{Binding PredProdUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4" ToolTip="{loc:Loc tooltip.predprodUsers}" IsEnabled="{Binding IncludePredProd}"/>
                                </StackPanel>
                            </WrapPanel>
                            <!-- Модулі по середовищах: окремий блок під назвою кожного середовища -->
                            <StackPanel Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}" Margin="0,6,0,0">
                                <TextBlock Text="{loc:Loc env.moduleUsers}" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4" ToolTip="{loc:Loc tooltip.moduleUsers}"/>
                                <WrapPanel>
                                    <!-- DEV -->
                                    <StackPanel Margin="0,0,18,6" IsEnabled="{Binding IncludeDev}">
                                        <TextBlock Text="DEV" FontWeight="Bold" Foreground="{DynamicResource AccentBg}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvModuleCounts}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc col.module}" Binding="{Binding ModuleName}" IsReadOnly="True" Width="Auto" MinWidth="100"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                                <DataGridTextColumn Header="к-сть" Binding="{Binding DevUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <!-- TEST -->
                                    <StackPanel Margin="0,0,18,6" IsEnabled="{Binding IncludeTest}">
                                        <TextBlock Text="TEST" FontWeight="Bold" Foreground="{DynamicResource AccentBg}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvModuleCounts}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc col.module}" Binding="{Binding ModuleName}" IsReadOnly="True" Width="Auto" MinWidth="100"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                                <DataGridTextColumn Header="к-сть" Binding="{Binding TestUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                    <!-- PreProd -->
                                    <StackPanel Margin="0,0,0,6" IsEnabled="{Binding IncludePredProd}">
                                        <TextBlock Text="PreProd" FontWeight="Bold" Foreground="{DynamicResource AccentBg}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvModuleCounts}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False" MaxHeight="160">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc col.module}" Binding="{Binding ModuleName}" IsReadOnly="True" Width="Auto" MinWidth="100"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="40"/>
                                                <DataGridTextColumn Header="к-сть" Binding="{Binding PredProdUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </WrapPanel>
                            </StackPanel>
                            <!-- Додаткові вузли по середовищах: окремо вмикаються для DEV/TEST/PreProd -->
                            <StackPanel Margin="0,8,0,0">
                                <TextBlock Text="Додаткові вузли по середовищах (PROD — у блоці вище):" FontSize="12" FontWeight="SemiBold"
                                           Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"/>
                                <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                          CanUserAddRows="False" CanUserDeleteRows="False" MaxWidth="520" HorizontalAlignment="Left">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="Auto" MinWidth="180"/>
                                        <DataGridCheckBoxColumn Header="DEV" Binding="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridCheckBoxColumn Header="TEST" Binding="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="70"/>
                                        <DataGridCheckBoxColumn Header="PreProd" Binding="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="24,12"
                                Command="{Binding CalculateCommand}" FontSize="15">
                            <TextBlock Text="{loc:Loc setup.calculate}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
