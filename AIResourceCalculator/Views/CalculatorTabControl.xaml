<UserControl x:Class="AIResourceCalculator.Views.CalculatorTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
             xmlns:loc="clr-namespace:AIResourceCalculator.Localization">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:ZeroEmptyConverter x:Key="ZeroEmptyConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <Grid>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="{loc:Loc setup.title}" Style="{StaticResource SectionHeader}"/>
                    <Border Background="{DynamicResource CardBg}" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc setup.users}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.users}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserCount" Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14" ToolTip="{loc:Loc tooltip.users}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc setup.product}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.product}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding ProductIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.product}">
                                    <ComboBoxItem Content="{loc:Loc product.standard}"/><ComboBoxItem Content="{loc:Loc product.documentflow}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc setup.deployment}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.deployment}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding DeploymentIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.deployment}">
                                    <ComboBoxItem Content="{loc:Loc deploy.k8s}"/><ComboBoxItem Content="{loc:Loc deploy.windows}"/><ComboBoxItem Content="{loc:Loc deploy.hybrid}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Database" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.database}"/>
                                <ComboBox Grid.Row="3" Grid.Column="1" SelectedIndex="{Binding DatabaseIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.database}">
                                    <ComboBoxItem Content="SQL Server"/><ComboBoxItem Content="PostgreSQL"/><ComboBoxItem Content="Oracle 19c"/>
                                </ComboBox>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc modules.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                            <ItemsControl x:Name="ModulesPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" Margin="4,2,14,2">
                                            <!-- Kubernetes-only модулі (ForceBPM) — галочка заблокована (керується типом розгортання). -->
                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                      VerticalAlignment="Center" ToolTip="{Binding Description}"
                                                      IsEnabled="{Binding IsUserToggleable}"/>
                                            <!-- Поле к-сті лише для модулів із власним контингентом (LMS/HR); ForceBPM — без к-сті. -->
                                            <TextBox Width="50" Margin="6,0,0,0" Padding="3,1" FontSize="12" VerticalAlignment="Center"
                                                     Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ZeroEmptyConverter}}"
                                                     ToolTip="{loc:Loc modules.usersTooltip}"
                                                     IsEnabled="{Binding IsEnabled}"
                                                     Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Додаткові вузли" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"
                                       ToolTip="Опціональні вузли — додаються до розрахунку лише коли увімкнені (типово вимкнені)"/>
                            <WrapPanel>
                                <CheckBox Content="Сервер звітів" IsChecked="{Binding IncludeReportingServer, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"
                                          ToolTip="Reporting Services, окремий вузол 2 ядра / 4 ГБ (Windows)"/>
                                <CheckBox Content="SQL Secondary (Failover)" IsChecked="{Binding IncludeSqlFailover, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"
                                          ToolTip="Другий вузол БД для failover-кластера (копія первинного вузла БД)"/>
                                <CheckBox Content="HAProxy" IsChecked="{Binding IncludeHaProxy, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"
                                          ToolTip="Балансувальник навантаження 2 ядра / 4 ГБ (Linux)"/>
                                <CheckBox Content="HAProxy HA (2 вузли)" IsChecked="{Binding HaProxyHa, Mode=TwoWay}" FontWeight="SemiBold"
                                          IsEnabled="{Binding IncludeHaProxy}"
                                          ToolTip="Відмовостійкість балансувальника: 2 вузли active/passive (keepalived/VRRP, спільний VIP). Діє лише коли HAProxy увімкнено."/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource CardBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{loc:Loc env.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8" ToolTip="{loc:Loc tooltip.env}"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8" ToolTip="{loc:Loc tooltip.env}">
                                <CheckBox Content="{loc:Loc env.dev}" IsChecked="{Binding IncludeDev, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <CheckBox Content="{loc:Loc env.test}" IsChecked="{Binding IncludeTest, Mode=TwoWay}" Margin="0,0,16,0" FontWeight="SemiBold"/>
                                <CheckBox Content="{loc:Loc env.predprod}" IsChecked="{Binding IncludePredProd, Mode=TwoWay}" FontWeight="SemiBold"/>
                            </StackPanel>
                            <!-- Картки середовищ: кожне ВВІМКНЕНЕ середовище — самодостатня картка
                                 (к-сть користувачів + модулі + опціональні вузли цього середовища).
                                 Вимкнені не показуються взагалі. PROD керується блоком вище. -->
                            <TextBlock Text="Налаштування ввімкнених середовищ" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,2,0,4"
                                       Visibility="{Binding HasEnvironmentsSelected, Converter={StaticResource VisibilityConverter}}"/>
                            <WrapPanel>
                                <!-- DEV -->
                                <Border Visibility="{Binding IncludeDev, Converter={StaticResource VisibilityConverter}}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6"
                                        Padding="10" Margin="0,0,12,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel Width="250">
                                        <TextBlock Text="{loc:Loc env.dev}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBg}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="60" Text="{Binding DevUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4" ToolTip="{loc:Loc tooltip.devUsers}"/>
                                        </StackPanel>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <!-- ForceBPM (HasOwnUserCount=false) — без поля к-сті, лише ✓ -->
                                                        <TextBox Grid.Column="2" Text="{Binding DevUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding DevEnabled}"
                                                                 Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <!-- TEST -->
                                <Border Visibility="{Binding IncludeTest, Converter={StaticResource VisibilityConverter}}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6"
                                        Padding="10" Margin="0,0,12,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel Width="250">
                                        <TextBlock Text="{loc:Loc env.test}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBg}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="60" Text="{Binding TestUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4" ToolTip="{loc:Loc tooltip.testUsers}"/>
                                        </StackPanel>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <!-- ForceBPM (HasOwnUserCount=false) — без поля к-сті, лише ✓ -->
                                                        <TextBox Grid.Column="2" Text="{Binding TestUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding TestEnabled}"
                                                                 Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <!-- PreProd -->
                                <Border Visibility="{Binding IncludePredProd, Converter={StaticResource VisibilityConverter}}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="6"
                                        Padding="10" Margin="0,0,12,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel Width="250">
                                        <TextBlock Text="{loc:Loc env.predprod}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource AccentBg}" Margin="0,0,0,4"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                            <TextBlock Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Width="60" Text="{Binding PredProdUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="4" ToolTip="{loc:Loc tooltip.predprodUsers}"/>
                                        </StackPanel>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <!-- ForceBPM (HasOwnUserCount=false) — без поля к-сті, лише ✓ -->
                                                        <TextBox Grid.Column="2" Text="{Binding PredProdUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding PredProdEnabled}"
                                                                 Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                        <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="24,12"
                                Command="{Binding CalculateCommand}" FontSize="15">
                            <TextBlock Text="{loc:Loc setup.calculate}"/>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
