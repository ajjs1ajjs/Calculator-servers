<UserControl x:Class="AIResourceCalculator.Views.CalculatorTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
             xmlns:loc="clr-namespace:AIResourceCalculator.Localization">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <conv:ZeroEmptyConverter x:Key="ZeroEmptyConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="{loc:Loc setup.title}" Style="{StaticResource SectionHeader}"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                                <Border Style="{StaticResource IconBadge}" Background="{DynamicResource AccentSoftBg}" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE713;" Foreground="{DynamicResource AccentBg}"/>
                                </Border>
                                <TextBlock Text="ОСНОВНІ НАЛАШТУВАННЯ" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Grid Margin="0,0,0,8">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc setup.users}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.users}"/>
                                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtUserCount" Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14" ToolTip="{loc:Loc tooltip.users}"/>
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc setup.deployment}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.deployment}"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" SelectedIndex="{Binding DeploymentIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.deployment}">
                                    <ComboBoxItem Content="{loc:Loc deploy.k8s}"/><ComboBoxItem Content="{loc:Loc deploy.windows}"/><ComboBoxItem Content="{loc:Loc deploy.hybrid}"/>
                                </ComboBox>
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Database" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.database}"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" SelectedIndex="{Binding DatabaseIndex, Mode=TwoWay}" Margin="3" Padding="4" ToolTip="{loc:Loc tooltip.database}">
                                    <ComboBoxItem Content="SQL Server"/><ComboBoxItem Content="PostgreSQL"/><ComboBoxItem Content="Oracle 19c"/>
                                </ComboBox>
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="{loc:Loc env.dbData}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.dbData}"/>
                                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ProdDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14" ToolTip="{loc:Loc tooltip.dbData}"/>
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="{loc:Loc env.contentData}" FontSize="14" VerticalAlignment="Center" Margin="3" ToolTip="{loc:Loc tooltip.contentData}"/>
                                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ProdContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14" ToolTip="{loc:Loc tooltip.contentData}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Style="{StaticResource IconBadge}" Background="{DynamicResource PurpleSoftBg}" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xEA86;" Foreground="{DynamicResource PurpleBg}"/>
                                </Border>
                                <TextBlock Grid.Column="1" Text="{loc:Loc modules.title}" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="Порожньо = усі користувачі" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center"/>
                            </Grid>
                            <ItemsControl x:Name="ModulesPanel">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource ChipRow}" Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <!-- Kubernetes-only модулі (ForceBPM) — галочка заблокована (керується типом розгортання). -->
                                                <CheckBox Grid.Column="0" IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Name}" FontSize="13" FontWeight="SemiBold"
                                                          VerticalAlignment="Center" ToolTip="{Binding Description}"
                                                          IsEnabled="{Binding IsUserToggleable}"/>
                                                <!-- Поле к-сті лише для модулів із власним контингентом (LMS/HR); ForceBPM — без к-сті. -->
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                                                            Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}">
                                                    <TextBlock Text="Користувачів:" FontSize="11" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                                    <TextBox Width="60" Padding="3,1" FontSize="12" VerticalAlignment="Center"
                                                             Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource ZeroEmptyConverter}}"
                                                             ToolTip="{loc:Loc modules.usersTooltip}"
                                                             IsEnabled="{Binding IsEnabled}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,14" ToolTip="Опціональні вузли — додаються до розрахунку лише коли увімкнені (типово вимкнені)">
                                <Border Style="{StaticResource IconBadge}" Background="{DynamicResource SurfaceBg}" Margin="0,0,10,0">
                                    <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE977;" Foreground="{DynamicResource TextMuted}"/>
                                </Border>
                                <TextBlock Text="ДОДАТКОВІ ВУЗЛИ СИСТЕМИ" Style="{StaticResource CardHeader}" Margin="0" VerticalAlignment="Center"/>
                            </StackPanel>
                            <UniformGrid Columns="3">
                                <Border Style="{StaticResource ChipRow}" Margin="0,0,8,0">
                                    <CheckBox Content="Сервер звітів" IsChecked="{Binding IncludeReportingServer, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12"
                                              ToolTip="Reporting Services, окремий вузол 2 ядра / 4 ГБ (Windows)"/>
                                </Border>
                                <Border Style="{StaticResource ChipRow}" Margin="0,0,8,0">
                                    <CheckBox Content="SQL Secondary (Failover)" IsChecked="{Binding IncludeSqlFailover, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12"
                                              ToolTip="Другий вузол БД для failover-кластера (копія первинного вузла БД)"/>
                                </Border>
                                <Border Style="{StaticResource ChipRow}">
                                    <CheckBox Content="HAProxy" IsChecked="{Binding IncludeHaProxy, Mode=TwoWay}" FontWeight="SemiBold" FontSize="12"
                                              IsEnabled="{Binding CanToggleHaProxy}"
                                              ToolTip="Балансувальник навантаження 2 ядра / 4 ГБ (Linux), 1 вузол. У Гібриді керується автоматично."/>
                                </Border>
                            </UniformGrid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <Grid>
                <StackPanel Grid.Column="0">
                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                        <StackPanel>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="{loc:Loc env.title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center" ToolTip="{loc:Loc tooltip.env}"/>
                                <Border Grid.Column="1" Style="{StaticResource PillGroup}" ToolTip="{loc:Loc tooltip.env}">
                                    <StackPanel Orientation="Horizontal">
                                        <CheckBox Content="{loc:Loc env.dev}" IsChecked="{Binding IncludeDev, Mode=TwoWay}" Style="{StaticResource EnvTogglePill}"/>
                                        <CheckBox Content="{loc:Loc env.test}" IsChecked="{Binding IncludeTest, Mode=TwoWay}" Style="{StaticResource EnvTogglePill}"/>
                                        <CheckBox Content="{loc:Loc env.predprod}" IsChecked="{Binding IncludePredProd, Mode=TwoWay}" Style="{StaticResource EnvTogglePill}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                            <!-- Картки середовищ: кожне ВВІМКНЕНЕ середовище — самодостатня картка
                                 (к-сть користувачів + модулі + опціональні вузли цього середовища).
                                 Вимкнені не показуються взагалі. PROD керується блоком вище. -->
                            <TextBlock Text="Налаштування ввімкнених середовищ" FontSize="12" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextMuted}" Margin="0,2,0,4"
                                       Visibility="{Binding HasEnvironmentsSelected, Converter={StaticResource VisibilityConverter}}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <!-- DEV -->
                                <Border Grid.Column="0" Visibility="{Binding IncludeDev, Converter={StaticResource VisibilityConverter}}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10"
                                        Padding="16" Margin="0,0,10,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <Ellipse Style="{StaticResource EnvDot}" Fill="{DynamicResource AccentBg}"/>
                                                <TextBlock Text="{loc:Loc env.dev}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Pill}">
                                                <TextBlock Text="АКТИВНЕ" Style="{StaticResource PillText}"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding DevUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="{loc:Loc tooltip.devUsers}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc env.dbData}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Margin="0,0,0,4" Text="{Binding DevDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="{loc:Loc tooltip.dbData}"/>
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Loc env.contentData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding DevContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="{loc:Loc tooltip.contentDataEnv}"/>
                                        </Grid>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <!-- ForceBPM (HasOwnUserCount=false) — без поля к-сті, лише ✓ -->
                                                        <TextBox Grid.Column="2" Text="{Binding DevUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding DevEnabled}"
                                                                 Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding DevEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34">
                                                    <DataGridCheckBoxColumn.ElementStyle>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEditable}"/>
                                                            <Setter Property="IsHitTestVisible" Value="{Binding IsEditable}"/>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.ElementStyle>
                                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEditable}"/>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                                </DataGridCheckBoxColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <!-- TEST -->
                                <Border Grid.Column="1" Visibility="{Binding IncludeTest, Converter={StaticResource VisibilityConverter}}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10"
                                        Padding="16" Margin="0,0,10,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <Ellipse Style="{StaticResource EnvDot}" Fill="{DynamicResource SuccessBg}"/>
                                                <TextBlock Text="{loc:Loc env.test}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Pill}">
                                                <TextBlock Text="АКТИВНЕ" Style="{StaticResource PillText}"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding TestUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="{loc:Loc tooltip.testUsers}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc env.dbData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding TestDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="Не менше розміру БД PROD; за замовчуванням дорівнює PROD"/>
                                        </Grid>
                                        <TextBlock Text="{Binding TestDbSizeWarning}" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource DangerBg}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Visibility="{Binding HasTestDbSizeWarning, Converter={StaticResource VisibilityConverter}}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc env.contentData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding TestContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="{loc:Loc tooltip.contentDataEnv}"/>
                                        </Grid>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <!-- ForceBPM (HasOwnUserCount=false) — без поля к-сті, лише ✓ -->
                                                        <TextBox Grid.Column="2" Text="{Binding TestUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding TestEnabled}"
                                                                 Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding TestEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34">
                                                    <DataGridCheckBoxColumn.ElementStyle>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEditable}"/>
                                                            <Setter Property="IsHitTestVisible" Value="{Binding IsEditable}"/>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.ElementStyle>
                                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEditable}"/>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                                </DataGridCheckBoxColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                                <!-- PreProd -->
                                <Border Grid.Column="2" Visibility="{Binding IncludePredProd, Converter={StaticResource VisibilityConverter}}"
                                        BorderBrush="{DynamicResource BorderColor}" BorderThickness="1" CornerRadius="10"
                                        Padding="16" Margin="0,0,0,8" Background="{DynamicResource HighlightBg}">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Orientation="Horizontal" Grid.Column="0">
                                                <Ellipse Style="{StaticResource EnvDot}" Fill="{DynamicResource PurpleBg}"/>
                                                <TextBlock Text="{loc:Loc env.predprod}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimary}"/>
                                            </StackPanel>
                                            <Border Grid.Column="1" Style="{StaticResource Pill}">
                                                <TextBlock Text="АКТИВНЕ" Style="{StaticResource PillText}"/>
                                            </Border>
                                        </Grid>
                                        <Grid Margin="0,0,0,2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc col.users}" VerticalAlignment="Center" Margin="0,0,6,4"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Margin="0,0,0,4" Text="{Binding PredProdUserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="{loc:Loc tooltip.predprodUsers}"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc env.dbData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding PredProdDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="Не менше розміру БД PROD; за замовчуванням дорівнює PROD"/>
                                        </Grid>
                                        <TextBlock Text="{Binding PredProdDbSizeWarning}" FontSize="10" FontStyle="Italic" Foreground="{DynamicResource DangerBg}"
                                                   TextWrapping="Wrap" Margin="0,0,0,6"
                                                   Visibility="{Binding HasPredProdDbSizeWarning, Converter={StaticResource VisibilityConverter}}"/>
                                        <Grid Margin="0,0,0,6">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="90"/></Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="{loc:Loc env.contentData}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                            <TextBox Grid.Column="1" Text="{Binding PredProdContentDbSizeGb, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="6,4" ToolTip="{loc:Loc tooltip.contentDataEnv}"/>
                                        </Grid>
                                        <TextBlock Text="Модулі" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"
                                                   Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}"/>
                                        <ItemsControl ItemsSource="{Binding EnvModuleCounts}" Margin="0,0,0,6"
                                                      Visibility="{Binding HasEnvModuleCounts, Converter={StaticResource VisibilityConverter}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Margin="0,1">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="22"/><ColumnDefinition Width="*"/><ColumnDefinition Width="58"/>
                                                        </Grid.ColumnDefinitions>
                                                        <CheckBox Grid.Column="0" IsChecked="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding ModuleName}" VerticalAlignment="Center"/>
                                                        <!-- ForceBPM (HasOwnUserCount=false) — без поля к-сті, лише ✓ -->
                                                        <TextBox Grid.Column="2" Text="{Binding PredProdUsers, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Padding="3,1" FontSize="12"
                                                                 IsEnabled="{Binding PredProdEnabled}"
                                                                 Visibility="{Binding HasOwnUserCount, Converter={StaticResource VisibilityConverter}}"/>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Text="Додаткові вузли" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,2"/>
                                        <DataGrid ItemsSource="{Binding EnvNodeToggles}" AutoGenerateColumns="False" HeadersVisibility="Column"
                                                  CanUserAddRows="False" CanUserDeleteRows="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Вузол" Binding="{Binding NodeName}" IsReadOnly="True" Width="*" MinWidth="120"/>
                                                <DataGridCheckBoxColumn Header="✓" Binding="{Binding PredProdEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Width="34">
                                                    <DataGridCheckBoxColumn.ElementStyle>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEditable}"/>
                                                            <Setter Property="IsHitTestVisible" Value="{Binding IsEditable}"/>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.ElementStyle>
                                                    <DataGridCheckBoxColumn.EditingElementStyle>
                                                        <Style TargetType="CheckBox">
                                                            <Setter Property="IsEnabled" Value="{Binding IsEditable}"/>
                                                        </Style>
                                                    </DataGridCheckBoxColumn.EditingElementStyle>
                                                </DataGridCheckBoxColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="24,14"
                            Command="{Binding CalculateCommand}" FontSize="15" Margin="0,15,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                            <TextBlock Text="&#xE9D9; " FontFamily="Segoe MDL2 Assets" VerticalAlignment="Center"/>
                            <TextBlock Text="{loc:Loc setup.calculate}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                    <!-- Швидкий підсумок останнього розрахунку — заповнює простір під кнопкою,
                         дублює вже обчислені значення (ті самі, що у вкладці "Результати"), без нової логіки. -->
                    <Border Style="{StaticResource Card}" Margin="0,16,0,0"
                            Visibility="{Binding HasResultSummary, Converter={StaticResource VisibilityConverter}}">
                        <StackPanel>
                            <TextBlock Text="ОСТАННІЙ РОЗРАХУНОК" Style="{StaticResource CardHeader}"/>
                            <UniformGrid Columns="5">
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalCpu}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBg}"/>
                                    <TextBlock Text="CPU" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalRam}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource SuccessBg}"/>
                                    <TextBlock Text="RAM" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalStorage}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource WarningBg}"/>
                                    <TextBlock Text="ДИСКИ" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,10,0">
                                    <TextBlock Text="{Binding TotalIops}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource PurpleBg}"/>
                                    <TextBlock Text="IOPS" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="{Binding TotalNodes}" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource DangerBg}"/>
                                    <TextBlock Text="ВМ" FontSize="10" Foreground="{DynamicResource TextMuted}"/>
                                </StackPanel>
                            </UniformGrid>
                            <TextBlock Text="{Binding ResultSummary}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                                       TextWrapping="Wrap" Margin="0,12,0,0"/>
                            <Button Background="Transparent" Foreground="{DynamicResource AccentBg}" FontWeight="Bold" Padding="0" Margin="0,10,0,0"
                                    HorizontalAlignment="Left" BorderThickness="0"
                                    Click="OpenResultsTab_Click">
                                <TextBlock Text="Детальніше у вкладці «Результати» &#x2192;" FontSize="12"/>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
