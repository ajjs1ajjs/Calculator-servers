<UserControl x:Class="AIResourceCalculator.Views.ResultsTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
             xmlns:loc="clr-namespace:AIResourceCalculator.Localization">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
        <StackPanel Margin="15">
            <TextBlock Text="{loc:Loc results.title}" Style="{StaticResource SectionHeader}"/>
            <Border Background="{DynamicResource HighlightBg}" Padding="14" CornerRadius="8" Margin="0,0,0,12"
                    BorderBrush="{DynamicResource AccentBg}" BorderThickness="1"
                    Visibility="{Binding HasResultSummary, Converter={StaticResource VisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc results.summaryTitle}" FontSize="15" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding ResultSummary}" FontSize="13" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" LineHeight="20"/>
                </StackPanel>
            </Border>
            <Border Background="{DynamicResource CardBg}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource AccentBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalCpu}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalVcpu}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalRam}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalRam}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalStorage}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalStorage}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource PurpleBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalIops}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalIops}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource DangerBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalNodes}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc col.nodes}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="{Binding PodRequests}" FontSize="11" FontStyle="Italic"
                       Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="2,0,0,12"
                       Visibility="{Binding HasPodRequests, Converter={StaticResource VisibilityConverter}}"/>
            <StackPanel Visibility="{Binding HasEnvironments, Converter={StaticResource VisibilityConverter}}" Margin="0,0,0,12">
                <TextBlock Text="{loc:Loc env.compare}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                <DataGrid ItemsSource="{Binding Environments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.env}" Binding="{Binding Name}" Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc col.users}" Binding="{Binding UserCount}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="70"/>
                        <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding StorageGb, StringFormat={}{0} GB}" Width="100"/>
                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops}" Width="80"/>
                        <DataGridTextColumn Header="{loc:Loc col.nodes}" Binding="{Binding Nodes}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Розбивка ВМ для кожного середовища -->
                <TextBlock Text="{loc:Loc env.vmsTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,4"/>
                <ItemsControl ItemsSource="{Binding Environments}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,8">
                                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,2">
                                    <Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" — ліцензій: "/><Run Text="{Binding UserCount, Mode=OneWay}"/>
                                </TextBlock>
                                <DataGrid ItemsSource="{Binding Vms}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="*"/>
                                        <DataGridTextColumn Header="{loc:Loc col.os}" Binding="{Binding Os}" Width="120"/>
                                        <DataGridTextColumn Header="{loc:Loc col.dbVersion}" Binding="{Binding DbVersion}" Width="150"/>
                                        <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="45"/>
                                        <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="45"/>
                                        <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="45"/>
                                        <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="90"/>
                                        <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops}" Width="60"/>
                                        <DataGridTextColumn Header="{loc:Loc col.notes}" Binding="{Binding Notes}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
            <TextBlock Text="{loc:Loc results.infra}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <DataGrid x:Name="GridInfrastructure" MinHeight="140" MaxHeight="300" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Loc col.os}" Binding="{Binding Os}" Width="120"/>
                    <DataGridTextColumn Header="{loc:Loc col.dbVersion}" Binding="{Binding DbVersion}" Width="150"/>
                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Loc col.storageType}" Binding="{Binding StorageType}" Width="70"/>
                    <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="40"/>
                    <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="75"/>
                    <DataGridTextColumn Header="{loc:Loc col.pagefile}" Binding="{Binding PageFileGb}" Width="80"/>
                    <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops}" Width="60"/>
                    <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency}" Width="70"/>
                    <DataGridTextColumn Header="{loc:Loc col.notes}" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Visibility="{Binding HasDocComparison, Converter={StaticResource VisibilityConverter}}" Margin="0,0,0,12">
                <TextBlock Text="{loc:Loc doc.compareTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                <DataGrid ItemsSource="{Binding DocComparison}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="{loc:Loc col.metric}" Binding="{Binding Metric}" Width="*"/>
                        <DataGridTextColumn Header="{loc:Loc col.docValue}" Binding="{Binding Document}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc col.calcValue}" Binding="{Binding Calculated}" Width="140"/>
                        <DataGridTextColumn Header="{loc:Loc col.status}" Binding="{Binding Status}" Width="140"/>
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
            <Border Background="{DynamicResource CardBg}" Padding="12" CornerRadius="8" Margin="0,0,0,8"
                    Visibility="{Binding HasDiskRecommendations, Converter={StaticResource VisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="{loc:Loc results.disksTitle}" FontSize="14" FontWeight="Bold"
                               Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <TextBlock Text="{Binding DiskRecommendations}" FontSize="12" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" LineHeight="18" FontFamily="Consolas"/>
                </StackPanel>
            </Border>
            <StackPanel Orientation="Horizontal">
                <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Command="{Binding ExportExcelCommand}" Content="Excel"/>
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportXmlCommand}" Content="XML"/>
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportHtmlCommand}" Content="HTML"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
