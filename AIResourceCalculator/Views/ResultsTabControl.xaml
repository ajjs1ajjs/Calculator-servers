<UserControl x:Class="AIResourceCalculator.Views.ResultsTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
             xmlns:loc="clr-namespace:AIResourceCalculator.Localization">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
    </UserControl.Resources>
    <Grid Margin="15">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0,0,8,0">
            <TextBlock Text="{loc:Loc results.title}" Style="{StaticResource SectionHeader}"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                        Visibility="{Binding HasHistory, Converter={StaticResource VisibilityConverter}}">
                <ComboBox ItemsSource="{Binding HistoryItems}" SelectedIndex="{Binding SelectedHistoryIndex, Mode=TwoWay}"
                          DisplayMemberPath="DisplayText" Width="350" Margin="0,0,8,0" Padding="4" FontSize="12"/>
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Padding="10,5" FontSize="12"
                        Command="{Binding RecallHistoryCommand}" Content="Recall"/>
            </StackPanel>
            <Border Background="{DynamicResource CardBg}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource AccentBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalCpu}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalVcpu}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalRam}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalRam}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalStorage}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalStorage}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource PurpleBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalIops}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalIops}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource DangerBg}" CornerRadius="6" Padding="6" Margin="2">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalNodes}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc col.nodes}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
            <TextBlock Text="{loc:Loc results.infra}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
            <DataGrid x:Name="GridInfrastructure" MinHeight="320" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Loc col.storageType}" Binding="{Binding StorageType}" Width="70"/>
                    <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="40"/>
                    <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="75"/>
                    <DataGridTextColumn Header="{loc:Loc col.notes}" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <StackPanel Orientation="Horizontal">
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportTxtCommand}" Content="TXT"/>
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportHtmlCommand}" Content="HTML"/>
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportSvgCommand}" Content="SVG"/>
                <Button Background="{DynamicResource PurpleBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                        Command="{Binding ShowDiagramCommand}" Content="{loc:Loc diagram.show}"/>
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportMermaidCommand}" Content="Mermaid"/>
                <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ShowScalingCommand}" Content="Scaling"/>
            </StackPanel>
            <Border x:Name="PanelDiagram" Background="{DynamicResource DiagramBg}" Padding="15" CornerRadius="8" Margin="0,8,0,0" Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                    <Border x:Name="DiagramContainer" Background="{DynamicResource DiagramBg}" MinWidth="400" MinHeight="200"/>
                </ScrollViewer>
            </Border>
            <Border x:Name="PanelScaling" Background="{DynamicResource CardBg}" Padding="10" CornerRadius="8" Margin="0,8,0,0"
                    Visibility="{Binding IsScalingVisible, Converter={StaticResource VisibilityConverter}}">
                <StackPanel>
                    <TextBlock Text="Resource Scaling" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,6"/>
                    <DataGrid MinHeight="120" MaxHeight="300" AutoGenerateColumns="False" IsReadOnly="True"
                              ItemsSource="{Binding ScalingData}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Users" Binding="{Binding Name}" Width="80"/>
                            <DataGridTextColumn Header="vCPU" Binding="{Binding Cpu}" Width="70"/>
                            <DataGridTextColumn Header="RAM (GB)" Binding="{Binding RamGb}" Width="80"/>
                            <DataGridTextColumn Header="Nodes" Binding="{Binding Replicas}" Width="60"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>

        <StackPanel Grid.Column="1" Margin="8,0,0,0">
            <TextBlock Text="{loc:Loc results.aiTitle}" Style="{StaticResource SectionHeader}"/>
            <Button Background="{DynamicResource PurpleBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="14,8" Margin="0,0,0,8"
                    Command="{Binding AnalyzeAiCommand}" HorizontalAlignment="Left">
                <TextBlock Text="{loc:Loc results.runAi}"/>
            </Button>
            <TextBlock Text="{Binding AiBadgeResultText}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,0,0,4"/>
            <DataGrid x:Name="AiTableResults" MinHeight="320" AutoGenerateColumns="False" IsReadOnly="True"
                      Visibility="{Binding IsAiRecListVisible, Converter={StaticResource VisibilityConverter}}">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="*"/>
                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="45"/>
                    <DataGridTextColumn Header="{loc:Loc col.storageType}" Binding="{Binding StorageType}" Width="70"/>
                    <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="40"/>
                    <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="75"/>
                    <DataGridTextColumn Header="{loc:Loc col.notes}" Binding="{Binding Notes}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
            <TextBlock Text="{Binding AiRecCountText}" FontSize="12" Foreground="{DynamicResource TextMuted}" Margin="0,8,0,4"/>
            <ItemsControl x:Name="AiRecResults" Visibility="{Binding IsAiRecListVisible, Converter={StaticResource VisibilityConverter}}" Margin="0,0,0,8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{DynamicResource CardBg}" Padding="10" CornerRadius="6" Margin="0,0,0,4" BorderThickness="1"
                                BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                            <StackPanel>
                                <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Action}" FontSize="12" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="TxtAiNoData" Text="{Binding AiNoDataText}" FontSize="13" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"
                       Visibility="{Binding IsAiNoDataVisible, Converter={StaticResource VisibilityConverter}}"/>
        </StackPanel>
    </Grid>
</UserControl>
