<UserControl x:Class="AIResourceCalculator.Views.ResultsTabControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
             xmlns:loc="clr-namespace:AIResourceCalculator.Localization">
    <UserControl.Resources>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <!-- Центрування числових клітинок у таблицях результатів. -->
        <Style x:Key="CenterCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="TextAlignment" Value="Center"/>
        </Style>
        <!-- Згортуваний розділ результатів. -->
        <Style x:Key="SectionExpander" TargetType="Expander">
            <Setter Property="IsExpanded" Value="True"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
    </UserControl.Resources>
    <ScrollViewer x:Name="RootScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                  CanContentScroll="False" PreviewMouseWheel="RootScroll_PreviewMouseWheel">
        <!-- Вміст на всю ширину програми (колонки таблиць ширші, менше переносів тексту). -->
        <StackPanel Margin="15" HorizontalAlignment="Stretch">
            <TextBlock Text="{loc:Loc results.title}" Style="{StaticResource SectionHeader}"/>

            <!-- KPI-картки (завжди видимі) -->
            <Border Background="{DynamicResource CardBg}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Background="{DynamicResource AccentBg}" CornerRadius="6" Padding="6" Margin="2" ToolTip="{loc:Loc tip.cpu}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalCpu}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalVcpu}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="1" Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="6" Margin="2" ToolTip="{loc:Loc tip.ram}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalRam}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalRam}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="6" Margin="2" ToolTip="{loc:Loc tip.storage}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalStorage}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalStorage}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="3" Background="{DynamicResource PurpleBg}" CornerRadius="6" Padding="6" Margin="2" ToolTip="{loc:Loc tip.iops}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalIops}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc results.totalIops}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="4" Background="{DynamicResource DangerBg}" CornerRadius="6" Padding="6" Margin="2" ToolTip="{loc:Loc tip.vms}">
                        <StackPanel HorizontalAlignment="Center">
                            <TextBlock Text="{Binding TotalNodes}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                            <TextBlock Text="{loc:Loc col.nodes}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Розділ: Підсумок потреб + Вимоги до дисків поруч (дві колонки) -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <!-- Ліворуч: підсумок потреб -->
                <Expander Grid.Column="0" Style="{StaticResource SectionExpander}" Header="{loc:Loc results.summaryTitle}"
                          Margin="0,0,8,10" VerticalAlignment="Top"
                          Visibility="{Binding HasResultSummary, Converter={StaticResource VisibilityConverter}}">
                    <StackPanel Margin="4,6,0,0">
                        <TextBlock Text="{Binding ResultSummary}" FontSize="13" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}"
                                   TextWrapping="Wrap" LineHeight="20"/>
                        <TextBlock Text="{Binding PodRequests}" FontSize="11" FontStyle="Italic" FontWeight="Normal"
                                   Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Visibility="{Binding HasPodRequests, Converter={StaticResource VisibilityConverter}}"/>
                    </StackPanel>
                </Expander>
                <!-- Праворуч: вимоги до дисків (поруч, бо є вільне місце) -->
                <Expander Grid.Column="1" Style="{StaticResource SectionExpander}" Header="{loc:Loc results.disksTitle}"
                          Margin="8,0,0,10" VerticalAlignment="Top"
                          Visibility="{Binding HasDiskRecommendations, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="{Binding DiskRecommendations}" FontSize="12" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" LineHeight="18" FontFamily="Consolas" Margin="4,6,0,0"/>
                </Expander>
            </Grid>

            <!-- Розділ: Середовища (порівняння + розбивка по середовищах, із власною прокруткою) -->
            <Expander Style="{StaticResource SectionExpander}" Header="{loc:Loc env.compare}"
                      Visibility="{Binding HasEnvironments, Converter={StaticResource VisibilityConverter}}">
                <StackPanel Margin="0,6,0,0">
                    <DataGrid ItemsSource="{Binding Environments}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontWeight="Normal" CanUserSortColumns="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc col.env}" Binding="{Binding Name}" Width="Auto" MinWidth="80"/>
                            <DataGridTextColumn Header="{loc:Loc col.users}" Binding="{Binding UserCount}" Width="80" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc env.moduleUsersCol}" Binding="{Binding ModulesInfo}" Width="*" MinWidth="200"/>
                            <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="70" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="80" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding StorageGb, StringFormat={}{0} GB}" Width="100" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops}" Width="80" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.nodes}" Binding="{Binding Nodes}" Width="90" ElementStyle="{StaticResource CenterCell}"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Розбивка ВМ та компонентів для кожного середовища (без внутрішньої прокрутки —
                         уся вкладка прокручується як одне ціле; довжину регулює згортання секцій). -->
                    <TextBlock Text="{loc:Loc env.vmsTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,10,0,4"/>
                    <TextBlock FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,0,0,6"
                               Text="Поди масштабуються блоками (на кожні 25/50/100 користувачів, мінімум 1 репліка), тож середовища з близькою к-стю користувачів можуть мати однакові компоненти — відмінності проявляються у вузлі БД."/>
                        <ItemsControl ItemsSource="{Binding Environments}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Expander IsExpanded="{Binding IsProd, Mode=OneWay}" Margin="0,0,0,6">
                                        <Expander.Header>
                                            <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentBg}">
                                                <Run Text="Середовище "/><Run Text="{Binding Name, Mode=OneWay}"/><Run Text=" — користувачів: "/><Run Text="{Binding UserCount, Mode=OneWay}"/>
                                            </TextBlock>
                                        </Expander.Header>
                                    <StackPanel Margin="0,4,0,8">
                                        <!-- К-сті модулів, з якими рахувалося середовище -->
                                        <TextBlock FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,4"
                                                   TextWrapping="Wrap" Visibility="{Binding HasModulesInfo, Converter={StaticResource VisibilityConverter}}">
                                            <Run Text="Модулі: "/><Run Text="{Binding ModulesInfo, Mode=OneWay}"/>
                                        </TextBlock>
                                        <DataGrid ItemsSource="{Binding Vms}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" FontWeight="Normal">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="Auto" MinWidth="100"/>
                                                <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="Auto" MinWidth="45" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.ghz}" Binding="{Binding Ghz, StringFormat={}{0:0.#}}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="Auto" MinWidth="45" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.storageType}" Binding="{Binding StorageType}" Width="Auto"/>
                                                <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="Auto" MinWidth="45" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="Auto" MinWidth="75" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.pagefile}" Binding="{Binding PageFileGb}" Width="Auto" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.iopsProfile}" Binding="{Binding IopsProfile}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.throughput}" Binding="{Binding ThroughputMiBs}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.os}" Binding="{Binding Os}" Width="Auto"/>
                                                <DataGridTextColumn Header="{loc:Loc col.dbVersion}" Binding="{Binding DbVersion}" Width="Auto"/>
                                                <DataGridTextColumn Header="{loc:Loc col.notes}" Binding="{Binding Notes}" Width="*" MinWidth="140"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Компоненти (поди) цього середовища -->
                                        <TextBlock Text="{loc:Loc results.envComponents}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextPrimary}" Margin="0,4,0,2"
                                                   Visibility="{Binding HasComponents, Converter={StaticResource VisibilityConverter}}"/>
                                        <DataGrid ItemsSource="{Binding Components}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                                  FontWeight="Normal"
                                                  Visibility="{Binding HasComponents, Converter={StaticResource VisibilityConverter}}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name}" Width="*" MinWidth="120"/>
                                                <DataGridTextColumn Header="{loc:Loc col.category}" Binding="{Binding Category}" Width="Auto" MinWidth="90"/>
                                                <DataGridTextColumn Header="{loc:Loc col.replicas}" Binding="{Binding Replicas}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, StringFormat={}{0:0.##}}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                                                <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, StringFormat={}{0:0.##}}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <!-- Підсумок компонентів середовища -->
                                        <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Margin="0,2,0,0"
                                                   Visibility="{Binding HasComponents, Converter={StaticResource VisibilityConverter}}">
                                            <Run Text="Разом подів: "/><Run Text="{Binding ComponentsCpu, Mode=OneWay}"/><Run Text=" CPU · "/><Run Text="{Binding ComponentsRamGb, Mode=OneWay}"/><Run Text=" ГБ RAM"/>
                                        </TextBlock>
                                    </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                </StackPanel>
            </Expander>

            <!-- Розділ: Інфраструктура (PROD) — лише коли немає розбивки по середовищах
                 (інакше PROD уже показано у «ВМ по середовищах» вище). -->
            <Expander Style="{StaticResource SectionExpander}" Header="{loc:Loc results.infraProd}"
                      Visibility="{Binding ShowProdInfraSection, Converter={StaticResource VisibilityConverter}}">
                <StackPanel Margin="0,6,0,0">
                    <TextBlock Text="{loc:Loc results.infraHint}" FontSize="11" FontStyle="Italic" FontWeight="Normal" Foreground="{DynamicResource TextPrimary}"
                               TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <DataGrid x:Name="GridInfrastructure" AutoGenerateColumns="False" IsReadOnly="True" FontWeight="Normal"
                              ItemsSource="{Binding ResultInfrastructure}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="Auto" MinWidth="100"/>
                            <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="Auto" MinWidth="45" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.ghz}" Binding="{Binding Ghz, StringFormat={}{0:0.#}}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="Auto" MinWidth="45" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.storageType}" Binding="{Binding StorageType}" Width="Auto"/>
                            <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="Auto" MinWidth="45" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="Auto" MinWidth="75" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.pagefile}" Binding="{Binding PageFileGb}" Width="Auto" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.iopsProfile}" Binding="{Binding IopsProfile}" Width="Auto" MinWidth="70" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.throughput}" Binding="{Binding ThroughputMiBs}" Width="Auto" MinWidth="55" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency}" Width="Auto" ElementStyle="{StaticResource CenterCell}"/>
                            <DataGridTextColumn Header="{loc:Loc col.os}" Binding="{Binding Os}" Width="Auto"/>
                            <DataGridTextColumn Header="{loc:Loc col.dbVersion}" Binding="{Binding DbVersion}" Width="Auto"/>
                            <DataGridTextColumn Header="{loc:Loc col.notes}" Binding="{Binding Notes}" Width="*" MinWidth="160"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Expander>

            <Border Background="{DynamicResource CardBg}" Padding="14" CornerRadius="10" Margin="0,10,0,0"
                    BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Експорт звіту" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                    <CheckBox Content="Включати компоненти (поди) у звіт" IsChecked="{Binding IncludeComponentsInReport, Mode=TwoWay}"
                              Margin="0,0,0,8"
                              ToolTip="Якщо вимкнено — розділи/аркуші з компонентами (подами) не потрапляють у Excel/PDF. На сам розрахунок не впливає."/>
                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ExportButton}" Background="{DynamicResource SuccessBg}"
                                Command="{Binding ExportExcelCommand}" ToolTip="Зберегти звіт у форматі Excel (.xlsx)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="Excel" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button Style="{StaticResource ExportButton}" Background="{DynamicResource DangerBg}"
                                Command="{Binding ExportPdfCommand}" ToolTip="Зберегти звіт у форматі PDF">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xEA90;" FontFamily="Segoe MDL2 Assets" FontSize="15" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="PDF" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
