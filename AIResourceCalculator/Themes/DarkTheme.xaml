<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Темна палітра (Catppuccin Mocha поверхні + ті самі акценти, що й у світлій темі —
         бренд-кольори лишаються впізнаваними в обох темах, контраст з білим текстом перевірений). -->
    <SolidColorBrush x:Key="WindowBg" Color="#1E1E2E"/>
    <SolidColorBrush x:Key="HeaderBg" Color="#1E66F5"/>
    <SolidColorBrush x:Key="StatusBarBg" Color="#11111B"/>
    <SolidColorBrush x:Key="CardBg" Color="#313244"/>
    <SolidColorBrush x:Key="InputBg" Color="#181825"/>
    <SolidColorBrush x:Key="InputFg" Color="#CDD6F4"/>
    <SolidColorBrush x:Key="InputBorder" Color="#45475A"/>
    <SolidColorBrush x:Key="GridBg" Color="#313244"/>
    <SolidColorBrush x:Key="GridAltBg" Color="#3A3B54"/>
    <SolidColorBrush x:Key="GridFg" Color="#CDD6F4"/>
