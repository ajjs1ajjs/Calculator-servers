<Window x:Class="AIResourceCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AIResourceCalculator.Localization"
        xmlns:views="clr-namespace:AIResourceCalculator.Views"
        Title="{loc:Loc app.title}" Height="900" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowBg}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#2AFFFFFF" CornerRadius="10" Width="42" Height="42" Margin="0,0,12,0">
                        <TextBlock Text="&#xE977;" FontFamily="Segoe MDL2 Assets" FontSize="20" Foreground="{DynamicResource TextWhite}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{loc:Loc app.title}" Foreground="{DynamicResource TextWhite}" FontSize="20" FontWeight="Bold"/>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{loc:Loc app.subtitle}" Foreground="{DynamicResource TextOnDark}" FontSize="12"/>
                            <TextBlock Text="{Binding AppVersion}" Foreground="{DynamicResource TextOnDark}" FontSize="12" Opacity="0.7" Margin="8,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="12,7" FontSize="13" Margin="0,0,6,0"
                            Command="{Binding ExportExcelCommand}" ToolTip="Зберегти звіт у форматі Excel (.xlsx)">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="Excel" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Background="{DynamicResource DangerBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="12,7" FontSize="13" Margin="0,0,16,0"
                            Command="{Binding ExportPdfCommand}" ToolTip="Зберегти звіт у форматі PDF">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEA90;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBlock Text="PDF" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Background="#24FFFFFF" Foreground="{DynamicResource TextWhite}" Padding="12,7" FontSize="13" Margin="0,0,8,0"
                            Command="{Binding ThemeSwitchCommand}" ToolTip="{loc:Loc tooltip.themeSwitch}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding ThemeIcon}" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding ThemeName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                    <Button Background="#24FFFFFF" Foreground="{DynamicResource TextWhite}" Padding="12,7" FontSize="13"
                            Command="{Binding LangSwitchCommand}" ToolTip="{loc:Loc tooltip.langSwitch}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LangFlag}" FontSize="15" Margin="0,0,6,0"/>
                            <TextBlock Text="{Binding LangName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Name="MainTabControl" Background="{DynamicResource WindowBg}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TabSetupHeader}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:CalculatorTabControl/>
            </TabItem>
            <TabItem>
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE9D9;" FontFamily="Segoe MDL2 Assets" FontSize="14" Margin="0,0,7,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding TabResultsHeader}" VerticalAlignment="Center"/>
                    </StackPanel>
                </TabItem.Header>
                <views:ResultsTabControl/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Padding="5">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="{Binding StatusText}" Foreground="{DynamicResource TextWhite}" FontSize="13"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
