<Window x:Class="AIResourceCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
        xmlns:loc="clr-namespace:AIResourceCalculator.Localization"
        xmlns:vm="clr-namespace:AIResourceCalculator.ViewModels"
        Title="{loc:Loc app.title}" Height="850" Width="1280"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        Foreground="{DynamicResource TextPrimary}">
    <Window.Resources>
        <conv:SeverityToColorConverter x:Key="SeverityToColor"/>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc app.title}" Foreground="{DynamicResource TextWhite}" FontSize="22" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc app.subtitle}" Foreground="{DynamicResource TextMuted}" FontSize="13"/>
                        <TextBlock Text="{Binding AiBadgeText}" Margin="10,0,0,0"
                                   FontSize="11" Foreground="#f39c12" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Name="BtnThemeToggle"
                        Background="#2c3e50" Foreground="{DynamicResource TextWhite}" BorderThickness="0"
                        Padding="10,5" FontSize="16" Margin="0,0,5,0"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="Toggle dark/light theme">
                        <TextBlock Text="{Binding ThemeIcon}"/>
                    </Button>
                    <Button Name="BtnAiSettings" Background="#8e44ad" Foreground="{DynamicResource TextWhite}" BorderThickness="0"
                            Padding="10,5" FontSize="12" Margin="0,0,5,0" Cursor="Hand"
                            Command="{Binding AiSettingsCommand}"
                            ToolTip="{loc:Loc tooltip.aiSettings}">
                        <TextBlock Text="{loc:Loc ai.settingsBtn}"/>
                    </Button>
                    <Button Name="BtnLangSwitch"
                        Background="#34495e" Foreground="{DynamicResource TextWhite}" BorderThickness="0"
                        Padding="10,5" FontSize="14"
                        Command="{Binding LangSwitchCommand}"
                        ToolTip="{loc:Loc tooltip.langSwitch}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LangFlag}" FontSize="18" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LangName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Name="MainTabControl" Background="{DynamicResource WindowBg}">
            <TabItem Header="{Binding TabMatrixHeader}" Name="TabMatrix">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <Border Background="{DynamicResource InfoBg}" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc matrix.info}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                    Command="{Binding ImportMatrixCommand}" Padding="16,8">
                                <TextBlock Text="{loc:Loc setup.import}"/>
                            </Button>
                            <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                    Command="{Binding SaveMatrixCommand}" Padding="16,8">
                                <TextBlock Text="{loc:Loc matrix.save}"/>
                            </Button>
                            <Button Command="{Binding ResetMatrixCommand}" Padding="12,8">
                                <TextBlock Text="{loc:Loc matrix.reset}"/>
                            </Button>
                        </StackPanel>
                        <Expander Header="{loc:Loc matrix.msSql}" IsExpanded="True" Foreground="{DynamicResource TextPrimary}">
                            <DataGrid Name="GridMatrixMsSql" Height="160" IsReadOnly="False" CanUserAddRows="True"
                                      Background="{DynamicResource DataGridBg}" AlternatingRowBackground="{DynamicResource AltRowBg}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <Expander Header="{loc:Loc matrix.performance}" Foreground="{DynamicResource TextPrimary}">
                            <DataGrid Name="GridMatrixMsSqlPerf" Height="140" IsReadOnly="False" CanUserAddRows="True"
                                      Background="{DynamicResource DataGridBg}" AlternatingRowBackground="{DynamicResource AltRowBg}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <Expander Header="{loc:Loc matrix.k8sComponents}" IsExpanded="True" Foreground="{DynamicResource TextPrimary}">
                            <DataGrid Name="GridMatrixComponents" Height="140" IsReadOnly="False" CanUserAddRows="True"
                                      Background="{DynamicResource DataGridBg}" AlternatingRowBackground="{DynamicResource AltRowBg}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="160"/>
                                    <DataGridTextColumn Header="{loc:Loc col.category}" Binding="{Binding Category, Mode=TwoWay}" Width="100"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.replicas}" Binding="{Binding Replicas, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <Expander Header="{loc:Loc matrix.infra}" IsExpanded="True" Foreground="{DynamicResource TextPrimary}">
                            <DataGrid Name="GridMatrixInfra" Height="140" IsReadOnly="False" CanUserAddRows="True"
                                      Background="{DynamicResource DataGridBg}" AlternatingRowBackground="{DynamicResource AltRowBg}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding StorageGb, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding TabSetupHeader}" Name="TabSetup">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:Loc setup.title}" Style="{StaticResource SectionHeader}"/>
                                <Border Background="{DynamicResource CardBg}" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc setup.users}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Name="TxtUserCount" Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14"
                                                     PreviewTextInput="NumberValidation" ToolTip="{loc:Loc tooltip.users}"/>

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc setup.deployment}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Name="CmbDeployment" SelectedIndex="{Binding DeploymentIndex, Mode=TwoWay}" Margin="3" Padding="4"
                                                      ToolTip="{loc:Loc tooltip.deployment}">
                                                <ComboBoxItem Content="{loc:Loc deploy.k8s}"/>
                                                <ComboBoxItem Content="{loc:Loc deploy.windows}"/>
                                                <ComboBoxItem Content="{loc:Loc deploy.hybrid}"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc modules.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                        <ItemsControl Name="ModulesPanel">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                                                              Content="{Binding Name}" Margin="4,2" FontSize="13" FontWeight="SemiBold"
                                                              ToolTip="{Binding Description}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{loc:Loc results.aiTitle}" Style="{StaticResource SectionHeader}"/>
                                <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AiNoDataText}" FontSize="13" Foreground="{DynamicResource TextMuted}"
                                                   FontStyle="Italic" TextWrapping="Wrap"/>
                                        <ItemsControl Name="QuickRecList" Visibility="Collapsed" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBg}" Padding="10" CornerRadius="6" Margin="0,0,0,4" BorderThickness="1"
                                                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                    <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="24,12"
                                            Command="{Binding CalculateCommand}" FontSize="15"
                                            ToolTip="{loc:Loc tooltip.calculate}">
                                        <TextBlock Text="{loc:Loc setup.calculate}"/>
                                    </Button>
                                    <Button Background="{DynamicResource WarningBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="24,12"
                                            Command="{Binding CompareCommand}" FontSize="15"
                                            ToolTip="Розрахувати два профілі та порівняти">
                                        <TextBlock Text="{loc:Loc results.compare}"/>
                                    </Button>
                                </StackPanel>

                                <Border Name="PanelCompareResult" Background="{DynamicResource PanelCompareBg}" Padding="12" CornerRadius="8" Margin="0,10,0,0"
                                        Visibility="{Binding IsCompareVisible, Converter={x:Static conv:VisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc results.compareTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                        <DataGrid Name="GridCompare" Height="130" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                                  Background="{DynamicResource DataGridBg}">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="" Binding="{Binding Name}" Width="100"/>
                                                <DataGridTextColumn Header="{loc:Loc profile.basic}" Binding="{Binding Basic}" Width="110"/>
                                                <DataGridTextColumn Header="{loc:Loc profile.performance}" Binding="{Binding Performance}" Width="110"/>
                                                <DataGridTextColumn Header="{loc:Loc results.recommended}" Binding="{Binding Recommended}" Width="110"
                                                                    FontWeight="Bold"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding TabResultsHeader}" Name="TabResults">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="{loc:Loc results.title}" Style="{StaticResource SectionHeader}"/>

                        <Border Background="{DynamicResource CardBg}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource AccentBg}" CornerRadius="6" Padding="8" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalCpu}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalVcpu}" FontSize="11" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="8" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalRam}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalRam}" FontSize="11" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="8" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalStorage}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalStorage}" FontSize="11" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource PurpleBg}" CornerRadius="6" Padding="8" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalIops}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalIops}" FontSize="11" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="{DynamicResource DangerBg}" CornerRadius="6" Padding="8" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalNodes}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc col.nodes}" FontSize="11" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <Expander Header="{loc:Loc results.details}" IsExpanded="False" Margin="0,0,0,8"
                                  Foreground="{DynamicResource TextPrimary}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                    <TextBlock Text="{loc:Loc results.infra}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                    <DataGrid Name="GridInfrastructure" Height="120" AutoGenerateColumns="False" IsReadOnly="True"
                                              Background="{DynamicResource DataGridBg}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="*"/>
                                            <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="55"/>
                                            <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="55"/>
                                            <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="55"/>
                                            <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="80"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                    <TextBlock Text="{loc:Loc results.compareTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                                    <DataGrid Name="GridCompareResults" Height="120" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column"
                                              Background="{DynamicResource DataGridBg}">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="" Binding="{Binding Name}" Width="80"/>
                                            <DataGridTextColumn Header="{loc:Loc profile.basic}" Binding="{Binding Basic}" Width="*"/>
                                            <DataGridTextColumn Header="{loc:Loc profile.performance}" Binding="{Binding Performance}" Width="*"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </StackPanel>
                            </Grid>
                        </Expander>

                        <Expander Header="{loc:Loc results.componentsDetail}" IsExpanded="False" Margin="0,0,0,8"
                                  Foreground="{DynamicResource TextPrimary}">
                            <DataGrid Name="GridComponentsDetail" Height="150" AutoGenerateColumns="False" IsReadOnly="True"
                                      Background="{DynamicResource DataGridBg}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name}" Width="160"/>
                                    <DataGridTextColumn Header="{loc:Loc col.category}" Binding="{Binding Category}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, StringFormat={}{0:F1}}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, StringFormat={}{0:F1} GB}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.replicas}" Binding="{Binding Replicas}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>

                        <Expander Header="{loc:Loc results.validations}" IsExpanded="False" Margin="0,0,0,8"
                                  Foreground="{DynamicResource TextPrimary}">
                            <ItemsControl Name="ValidationList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Padding="8" CornerRadius="4" Margin="0,0,0,3"
                                                BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding ResourceName}" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="5,0">
                                                    <TextBlock Text="{Binding Required, StringFormat='Need: {0:F1}'}" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                                                    <TextBlock Text="{Binding Allocated, StringFormat='Have: {0:F1}'}" Foreground="{DynamicResource TextMuted}" Margin="0,0,10,0"/>
                                                    <TextBlock Foreground="{DynamicResource AccentBg}">
                                                        <TextBlock.Text>
                                                            <MultiBinding StringFormat="{}{0:F1}%">
                                                                <Binding Path="DeltaPercent"/>
                                                            </MultiBinding>
                                                        </TextBlock.Text>
                                                    </TextBlock>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Severity}" FontWeight="Bold"
                                                           Foreground="{Binding Severity, Converter={StaticResource SeverityToColor}}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Expander>

                        <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <TextBlock Text="{loc:Loc results.aiTitle}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" VerticalAlignment="Center"/>
                                    <TextBlock Text="{Binding AiBadgeResultText}" FontSize="12" Foreground="{DynamicResource TextMuted}" VerticalAlignment="Center" Margin="10,0,0,0"/>
                                </StackPanel>
                                <ItemsControl Name="AiRecList" Visibility="Collapsed">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" CornerRadius="6" Margin="0,0,0,4" BorderThickness="1"
                                                    Background="{DynamicResource CardBg}" BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="36" Height="36" CornerRadius="18" Margin="0,0,10,0"
                                                            Background="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                                        <TextBlock Text="{Binding DirectionEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="16"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding Action}" FontSize="11" Foreground="{DynamicResource AccentBg}" TextWrapping="Wrap" Margin="0,2,0,0"/>
                                                        <TextBlock Text="{Binding PotentialSavings, StringFormat='${0:F0}/mo'}" FontSize="12" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SuccessBg}" Margin="0,3,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Name="TxtAiNoData" Text="{Binding AiNoDataText}" FontSize="13" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Command="{Binding ExportTxtCommand}" Background="#34495e" Foreground="{DynamicResource TextWhite}" Content="TXT"/>
                            <Button Command="{Binding ExportPdfCommand}" Background="#34495e" Foreground="{DynamicResource TextWhite}" Content="PDF"/>
                            <Button Background="{DynamicResource PurpleBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                    Command="{Binding ShowDiagramCommand}" Content="{loc:Loc diagram.show}"/>
                            <Button Command="{Binding ExportMermaidCommand}" Background="{DynamicResource HeaderBg}" Foreground="{DynamicResource TextWhite}" Content="Mermaid"/>
                        </StackPanel>

                        <Border Name="PanelDiagram" Background="{DynamicResource DiagramBg}" Padding="15" CornerRadius="8" Margin="0,8,0,0" Visibility="Collapsed">
                            <StackPanel>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="500">
                                    <Border Name="DiagramContainer" Background="{DynamicResource DiagramBg}" MinWidth="600" MinHeight="300"/>
                                </ScrollViewer>
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Command="{Binding ExportSvgCommand}" Padding="10,5" Content="SVG"/>
                                    <Button Command="{Binding ExportMermaidCommand}" Padding="10,5" Content="Mermaid"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{Binding TabAiQueryHeader}" Name="TabAiQuery">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="{loc:Loc aiQuery.title}" Style="{StaticResource SectionHeader}"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <Border Background="#fef9e7" Padding="15" CornerRadius="8" BorderBrush="#f39c12" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc aiQuery.desc}" FontSize="13" Foreground="#856404" TextWrapping="Wrap"/>
                                        <TextBox Name="TxtAiQueryPrompt" Height="80" Margin="0,10,0,5" Padding="8"
                                                 FontSize="13" TextWrapping="Wrap" Text="{Binding AiQueryPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                        <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                                Command="{Binding AiQuerySendCommand}" Padding="16,8" HorizontalAlignment="Left">
                                            <TextBlock Text="{loc:Loc aiQuery.analyze}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <Border Name="AiQueryResultPanel" Background="{DynamicResource InfoBg}" Padding="15" CornerRadius="8"
                                        Visibility="{Binding IsAiQueryResultVisible, Converter={x:Static conv:VisibilityConverter.Instance}}">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc aiQuery.result}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                        <TextBlock Name="TxtAiQueryResult" Text="{Binding AiQueryResult}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                                        <Button Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                                Command="{Binding ApplyAiQueryCommand}" Padding="14,8" HorizontalAlignment="Left" Margin="0,10,0,0"
                                                Visibility="{Binding IsApplyAiQueryVisible, Converter={x:Static conv:VisibilityConverter.Instance}}">
                                            <TextBlock Text="{loc:Loc aiQuery.apply}"/>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource CardBg}" Padding="12" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc aiQuery.templates}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                        <Button Command="{Binding Template1Command}" Background="{DynamicResource AltRowBg}" Padding="10,6" Margin="2"
                                                Content="{loc:Loc aiQuery.tpl1}" HorizontalAlignment="Left"/>
                                        <Button Command="{Binding Template2Command}" Background="{DynamicResource AltRowBg}" Padding="10,6" Margin="2"
                                                Content="{loc:Loc aiQuery.tpl2}" HorizontalAlignment="Left"/>
                                        <Button Command="{Binding Template3Command}" Background="{DynamicResource AltRowBg}" Padding="10,6" Margin="2"
                                                Content="{loc:Loc aiQuery.tpl3}" HorizontalAlignment="Left"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Background="{DynamicResource StatusBarBg}" Padding="5">
            <StatusBarItem>
                <TextBlock Name="TxtStatus" Text="{Binding StatusText}" Foreground="{DynamicResource TextWhite}" FontSize="13"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
