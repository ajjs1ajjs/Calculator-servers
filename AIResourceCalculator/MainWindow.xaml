<Window x:Class="AIResourceCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:AIResourceCalculator.Localization"
        xmlns:views="clr-namespace:AIResourceCalculator.Views"
        Title="{loc:Loc app.title}" Height="900" Width="1300"
        MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc app.title}" Foreground="{DynamicResource TextWhite}" FontSize="22" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc app.subtitle}" Foreground="{DynamicResource TextOnDark}" FontSize="13"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="Transparent" Foreground="{DynamicResource TextWhite}" Padding="10,5" FontSize="14"
                            Command="{Binding LangSwitchCommand}" ToolTip="{loc:Loc tooltip.langSwitch}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LangFlag}" FontSize="18" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LangName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Name="MainTabControl" Background="{DynamicResource WindowBg}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">
            <TabItem Header="{Binding TabSetupHeader}">
                <views:CalculatorTabControl/>
            </TabItem>
            <TabItem Header="{Binding TabResultsHeader}">
                <views:ResultsTabControl/>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Padding="5">
            <StatusBarItem>
                <TextBlock x:Name="TxtStatus" Text="{Binding StatusText}" Foreground="{DynamicResource TextWhite}" FontSize="13"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
