<Window x:Class="AIResourceCalculator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AIResourceCalculator.Converters"
        xmlns:loc="clr-namespace:AIResourceCalculator.Localization"
        Title="{loc:Loc app.title}" Height="900" Width="1300"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}">
    <Window.Resources>
        <conv:SeverityToColorConverter x:Key="SeverityToColor"/>
        <conv:VisibilityConverter x:Key="VisibilityConverter"/>
        <Style TargetType="TabItem">
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontWeight" Value="Bold"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style TargetType="TextBlock" x:Key="SectionHeader">
            <Setter Property="FontSize" Value="18"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Margin" Value="0,0,0,10"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="{DynamicResource GridBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="AlternatingRowBackground" Value="{DynamicResource GridAltBg}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource GridHeaderBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource GridHeaderFg}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource InputFg}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}"/>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource InputBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource InputFg}"/>
        </Style>
        <Style TargetType="StatusBar">
            <Setter Property="Background" Value="{DynamicResource StatusBarBg}"/>
        </Style>
        <Style TargetType="Expander">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBg}" Padding="10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock Text="{loc:Loc app.title}" Foreground="{DynamicResource TextWhite}" FontSize="22" FontWeight="Bold"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{loc:Loc app.subtitle}" Foreground="{DynamicResource TextOnDark}" FontSize="13"/>
                        <TextBlock Text="{Binding AiBadgeText}" Margin="10,0,0,0"
                                   FontSize="11" Foreground="{DynamicResource WarningBg}" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Background="Transparent" Foreground="{DynamicResource TextWhite}" Padding="10,5" FontSize="15"
                            Command="{Binding ToggleThemeCommand}" ToolTip="Toggle theme">
                        <TextBlock Text="{Binding ThemeIcon}"/>
                    </Button>
                    <Button Background="{DynamicResource PurpleBg}" Foreground="{DynamicResource TextWhite}" Padding="10,5" FontSize="12"
                            Command="{Binding AiSettingsCommand}" ToolTip="{loc:Loc tooltip.aiSettings}">
                        <TextBlock Text="{loc:Loc ai.settingsBtn}"/>
                    </Button>
                    <Button Background="Transparent" Foreground="{DynamicResource TextWhite}" Padding="10,5" FontSize="14"
                            Command="{Binding LangSwitchCommand}" ToolTip="{loc:Loc tooltip.langSwitch}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding LangFlag}" FontSize="18" Margin="0,0,5,0"/>
                            <TextBlock Text="{Binding LangName}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" Name="MainTabControl" Background="{DynamicResource WindowBg}"
                    SelectedIndex="{Binding SelectedTabIndex, Mode=TwoWay}">

            <!-- TAB 1: Data Matrix -->
            <TabItem Header="{Binding TabMatrixHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,0,0,10">
                            <TextBlock Text="{loc:Loc matrix.info}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap"/>
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="16,8"
                                    Command="{Binding ImportMatrixCommand}">
                                <TextBlock Text="{loc:Loc setup.import}"/>
                            </Button>
                            <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="16,8"
                                    Command="{Binding SaveMatrixCommand}">
                                <TextBlock Text="{loc:Loc matrix.save}"/>
                            </Button>
                            <Button Command="{Binding ResetMatrixCommand}" Padding="12,8">
                                <TextBlock Text="{loc:Loc matrix.reset}"/>
                            </Button>
                        </StackPanel>
                        <Expander Header="{loc:Loc matrix.msSql}" IsExpanded="True">
                            <DataGrid Name="GridMatrixMsSql" Height="160" IsReadOnly="False" CanUserAddRows="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <Expander Header="{loc:Loc matrix.performance}">
                            <DataGrid Name="GridMatrixMsSqlPerf" Height="140" IsReadOnly="False" CanUserAddRows="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.minUsers}" Binding="{Binding MinUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.maxUsers}" Binding="{Binding MaxUsers, Mode=TwoWay}" Width="80"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramMin}" Binding="{Binding RamMin, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ramRec}" Binding="{Binding RamRec, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.iops}" Binding="{Binding Iops, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.latency}" Binding="{Binding Latency, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <Expander Header="{loc:Loc matrix.k8sComponents}" IsExpanded="True">
                            <DataGrid Name="GridMatrixComponents" Height="140" IsReadOnly="False" CanUserAddRows="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="160"/>
                                    <DataGridTextColumn Header="{loc:Loc col.category}" Binding="{Binding Category, Mode=TwoWay}" Width="100"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.replicas}" Binding="{Binding Replicas, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                        <Expander Header="{loc:Loc matrix.infra}" IsExpanded="True">
                            <DataGrid Name="GridMatrixInfra" Height="140" IsReadOnly="False" CanUserAddRows="True">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="{loc:Loc col.name}" Binding="{Binding Name, Mode=TwoWay}" Width="120"/>
                                    <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount, Mode=TwoWay}" Width="60"/>
                                    <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding StorageGb, Mode=TwoWay}" Width="60"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 2: Calculator -->
            <TabItem Header="{Binding TabSetupHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="{loc:Loc setup.title}" Style="{StaticResource SectionHeader}"/>
                                <Border Background="{DynamicResource CardBg}" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource BorderColor}" BorderThickness="1">
                                    <StackPanel>
                                        <Grid Margin="0,0,0,8">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                            </Grid.RowDefinitions>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="180"/><ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Loc setup.users}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                            <TextBox Grid.Row="0" Grid.Column="1" Name="TxtUserCount" Text="{Binding UserCount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Margin="3" Padding="5" FontSize="14"
                                                     PreviewTextInput="NumberValidation"/>
                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Loc setup.deployment}" FontSize="14" VerticalAlignment="Center" Margin="3"/>
                                            <ComboBox Grid.Row="1" Grid.Column="1" Name="CmbDeployment" SelectedIndex="{Binding DeploymentIndex, Mode=TwoWay}" Margin="3" Padding="4">
                                                <ComboBoxItem Content="{loc:Loc deploy.k8s}"/><ComboBoxItem Content="{loc:Loc deploy.windows}"/><ComboBoxItem Content="{loc:Loc deploy.hybrid}"/>
                                            </ComboBox>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,12,0,0" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{loc:Loc modules.title}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                        <ItemsControl Name="ModulesPanel">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay}" Content="{Binding Name}" Margin="4,2" FontSize="13" FontWeight="SemiBold"
                                                              ToolTip="{Binding Description}"/>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                <TextBlock Text="{loc:Loc results.aiTitle}" Style="{StaticResource SectionHeader}"/>
                                <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding AiNoDataText}" FontSize="13" Foreground="{DynamicResource TextMuted}" FontStyle="Italic" TextWrapping="Wrap"/>
                                        <ItemsControl Name="QuickRecList" Visibility="{Binding IsQuickRecVisible, Converter={StaticResource VisibilityConverter}}" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource CardBg}" Padding="10" CornerRadius="6" Margin="0,0,0,4" BorderThickness="1"
                                                            BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                            <TextBlock Text="{Binding Description}" FontSize="12" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap"/>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                    <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="24,12"
                                            Command="{Binding CalculateCommand}" FontSize="15">
                                        <TextBlock Text="{loc:Loc setup.calculate}"/>
                                    </Button>
                                </StackPanel>

                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- TAB 3: Results -->
            <TabItem Header="{Binding TabResultsHeader}">
                <Grid Margin="15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: Math from data -->
                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="{loc:Loc results.title}" Style="{StaticResource SectionHeader}"/>

                        <Border Background="{DynamicResource CardBg}" Padding="12" CornerRadius="8" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="{DynamicResource AccentBg}" CornerRadius="6" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalCpu}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalVcpu}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="1" Background="{DynamicResource SuccessBg}" CornerRadius="6" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalRam}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalRam}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Background="{DynamicResource WarningBg}" CornerRadius="6" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalStorage}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalStorage}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="3" Background="{DynamicResource PurpleBg}" CornerRadius="6" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalIops}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc results.totalIops}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="4" Background="{DynamicResource DangerBg}" CornerRadius="6" Padding="6" Margin="2">
                                    <StackPanel HorizontalAlignment="Center">
                                        <TextBlock Text="{Binding TotalNodes}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource TextWhite}"/>
                                        <TextBlock Text="{loc:Loc col.nodes}" FontSize="10" Foreground="{DynamicResource TextOnDark}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <TextBlock Text="{loc:Loc results.infra}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,5"/>
                        <DataGrid Name="GridInfrastructure" MinHeight="320" AutoGenerateColumns="False" IsReadOnly="True" Margin="0,0,0,12">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="{loc:Loc col.nodeType}" Binding="{Binding Name}" Width="*"/>
                                <DataGridTextColumn Header="{loc:Loc col.cpu}" Binding="{Binding Cpu}" Width="50"/>
                                <DataGridTextColumn Header="{loc:Loc col.ram}" Binding="{Binding RamGb}" Width="50"/>
                                <DataGridTextColumn Header="{loc:Loc col.count}" Binding="{Binding NodeCount}" Width="50"/>
                                <DataGridTextColumn Header="{loc:Loc col.storage}" Binding="{Binding TotalStorageGb, StringFormat={}{0} GB}" Width="75"/>
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Orientation="Horizontal">
                            <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportTxtCommand}" Content="TXT"/>
                            <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportPdfCommand}" Content="PDF"/>
                            <Button Background="{DynamicResource PurpleBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                    Command="{Binding ShowDiagramCommand}" Content="{loc:Loc diagram.show}"/>
                            <Button Background="{DynamicResource CardBg}" Foreground="{DynamicResource TextPrimary}" Command="{Binding ExportMermaidCommand}" Content="Mermaid"/>
                        </StackPanel>

                        <Border Name="PanelDiagram" Background="{DynamicResource DiagramBg}" Padding="15" CornerRadius="8" Margin="0,8,0,0" Visibility="Collapsed">
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                <Border Name="DiagramContainer" Background="{DynamicResource DiagramBg}" MinWidth="400" MinHeight="200"/>
                            </ScrollViewer>
                        </Border>
                    </StackPanel>

                    <!-- RIGHT: AI Smart Analysis -->
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="{loc:Loc results.aiTitle}" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" BorderBrush="{DynamicResource AccentBg}" BorderThickness="1">
                            <StackPanel>
                                <Button Background="{DynamicResource PurpleBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold" Padding="14,8" Margin="0,0,0,10"
                                        Command="{Binding AnalyzeAiCommand}" HorizontalAlignment="Left">
                                    <TextBlock Text="&#x1F9E0; Run AI Analysis"/>
                                </Button>
                                <ItemsControl Name="AiRecList" Visibility="{Binding IsAiRecListVisible, Converter={StaticResource VisibilityConverter}}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="10" CornerRadius="6" Margin="0,0,0,4" BorderThickness="1"
                                                    Background="{DynamicResource CardBg}" BorderBrush="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="32" Height="32" CornerRadius="16" Margin="0,0,8,0"
                                                            Background="{Binding Severity, Converter={StaticResource SeverityToColor}}">
                                                        <TextBlock Text="{Binding DirectionEmoji}" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="14"/>
                                                    </Border>
                                                    <StackPanel Grid.Column="1">
                                                        <TextBlock Text="{Binding Title}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}"/>
                                                        <TextBlock Text="{Binding Description}" FontSize="11" Foreground="{DynamicResource TextMuted}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                        <TextBlock Text="{Binding Action}" FontSize="10" Foreground="{DynamicResource AccentBg}" TextWrapping="Wrap" Margin="0,1,0,0"/>
                                                        <TextBlock Text="{Binding PotentialSavings, StringFormat='${0:F0}/mo'}" FontSize="11" FontWeight="Bold"
                                                                   Foreground="{DynamicResource SuccessBg}" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock Name="TxtAiNoData" Text="{Binding AiNoDataText}" FontSize="13" Foreground="{DynamicResource TextMuted}" FontStyle="Italic"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
            </TabItem>

            <!-- TAB 4: AI Assistant -->
            <TabItem Header="{Binding TabAiQueryHeader}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="15">
                        <TextBlock Text="{loc:Loc aiQuery.title}" Style="{StaticResource SectionHeader}"/>
                        <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8" Margin="0,0,0,12">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc aiQuery.desc}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,8"/>
                                <TextBox Name="TxtAiQueryPrompt" Height="100" Margin="0,0,0,8" Padding="8"
                                         FontSize="13" TextWrapping="Wrap" Text="{Binding AiQueryPrompt, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                                <Button Background="{DynamicResource AccentBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                        Command="{Binding AiQuerySendCommand}" Padding="16,8" HorizontalAlignment="Left">
                                    <TextBlock Text="{loc:Loc aiQuery.analyze}"/>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Background="{DynamicResource HighlightBg}" Padding="15" CornerRadius="8"
                                Visibility="{Binding IsAiQueryResultVisible, Converter={StaticResource VisibilityConverter}}">
                            <StackPanel>
                                <TextBlock Text="{loc:Loc aiQuery.result}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Margin="0,0,0,8"/>
                                <TextBlock Text="{Binding AiQueryResult}" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" Margin="0,0,0,10"/>
                                <Button Background="{DynamicResource SuccessBg}" Foreground="{DynamicResource TextWhite}" FontWeight="Bold"
                                        Command="{Binding ApplyAiQueryCommand}" Padding="14,8" HorizontalAlignment="Left"
                                        Visibility="{Binding IsApplyAiQueryVisible, Converter={StaticResource VisibilityConverter}}">
                                    <TextBlock Text="{loc:Loc aiQuery.apply}"/>
                                </Button>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StatusBar Grid.Row="2" Padding="5">
            <StatusBarItem>
                <TextBlock Name="TxtStatus" Text="{Binding StatusText}" Foreground="{DynamicResource TextWhite}" FontSize="13"/>
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
